//@version=5
indicator("conditional")
even = bar_index % 2 == 0
plot(even ? ta.cum(close) : na)
plot(even and ta.cum(close) > 0 ? 1 : 0)
plot(even or ta.cum(close) > 0 ? 1 : 0)
x = if even
    ta.cum(close)
else
    0
plot(x)
h = if even
    close[1]
else
    0
plot(h)
s = 0.0
for i = 0 to 2
    s := s + ta.cum(close)
plot(s)
