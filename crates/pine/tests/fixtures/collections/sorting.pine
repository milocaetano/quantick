//@version=6
indicator("Sorting")
a = array.from(3.0, 1.0, 3.0, na, 2.0)
i = a.sort_indices()
plot(array.join(i, ":") == "1:4:0:2:3" ? 1 : 0)
plot(a.first())
a.sort()
plot(a.first())
plot(na(a.last()) ? 1 : 0)
a.sort(order.descending)
plot(na(a.first()) ? 1 : 0)
plot(a.last())
s = array.from("b", "", "A", "a")
s.sort()
plot(s.join(":") == "A:a:b:" ? 1 : 0)
s.sort(order.descending)
plot(s.join(":") == ":b:a:A" ? 1 : 0)
e = array.new_int()
e.sort()
plot(e.sort_indices().size())
