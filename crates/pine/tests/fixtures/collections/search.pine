//@version=6
indicator("Binary searches")
a = array.from(1, 3, 3, 5)
plot(a.binary_search(5))
plot(a.binary_search(2))
plot(a.binary_search_leftmost(3))
plot(a.binary_search_rightmost(3))
plot(a.binary_search_leftmost(2))
plot(a.binary_search_rightmost(2))
plot(a.binary_search_leftmost(0))
plot(a.binary_search_rightmost(6))
e = array.new_float()
plot(e.binary_search(1))
plot(e.binary_search_leftmost(1))
plot(e.binary_search_rightmost(1))
