//@version=5
indicator("Collection rollback")
var a = array.new_float(0)
b = a
array.push(b, close)
c = array.copy(a)
array.set(c, 0, 999)
var m = map.new<string, float>()
map.put(m, "z", close)
map.put(m, "a", 7)
map.put(m, "z", close + 1)
keys = map.keys(m)
values = map.values(m)
array.set(values, 0, 999)
plot(array.size(a))
plot(array.get(a, 0))
plot(map.get(m, "z"))
plot(array.get(keys, 0) == "z" ? 1 : 0)
plot(array.get(c, 0))
