//@version=6
indicator("Statistics")
a = array.from(1.0, 2.0, 3.0, 4.0, na)
plot(a.avg())
plot(a.median())
plot(a.min(1))
plot(a.max(1))
plot(a.range())
plot(a.variance())
plot(a.variance(false))
plot(a.stdev())
plot(a.percentile_linear_interpolation(25))
plot(a.percentile_nearest_rank(25))
plot(a.percentrank(1))
z = a.standardize()
plot(z.get(0))
plot(na(z.get(4)) ? 1 : 0)
plot(array.covariance(array.from(1.0, 2.0, 3.0), array.from(2.0, 4.0, 6.0)))
plot(array.covariance(array.from(1.0, 2.0, 3.0), array.from(2.0, 4.0, 6.0), false))
plot(array.from(3, 1, 1, 3).mode())
plot(array.from(3, 1, 2).mode())
b = array.from(-2, 3)
c = b.abs()
plot(c.sum())
plot(b.first())
e = array.new_float()
plot(na(e.median()) ? 1 : 0)
plot(e.standardize().size())
