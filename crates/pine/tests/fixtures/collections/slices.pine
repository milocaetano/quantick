//@version=6
indicator("Shared slices")
a = array.from(1, 2, 3, 4, 5)
s = array.slice(a, 1, 4)
s.set(0, 20)
plot(a.get(1))
a.set(2, 30)
plot(s.get(1))
s.push(40)
plot(a.join(":") == "1:20:30:4:40:5" ? 1 : 0)
s.shift()
plot(a.join(":") == "1:30:4:40:5" ? 1 : 0)
plot(s.size())
t = s.slice(1, 3)
t.reverse()
plot(a.join(":") == "1:30:40:4:5" ? 1 : 0)
c = s.copy()
c.clear()
plot(s.size())
a.clear()
plot(s.size())
a.push(9)
a.push(8)
a.push(7)
plot(s.size())
plot(s.first())
a := array.new_int()
plot(s.first())
s.clear()
plot(t.size())
