//@version=6
indicator("Named collection defaults")
a = array.from(1, 2, 3)
a.fill(9, index_to = 2)
plot(a.join(":") == "9:9:3" ? 1 : 0)
array.fill(a, 7, index_to = 1)
plot(a.join(":") == "7:9:3" ? 1 : 0)
b = array.new_int(initial_value = 9)
plot(b.size())
c = array.new<float>(initial_value = 1.5)
plot(c.size())
