//@version=6
indicator("versions")
plot(5 / 2)
bool flag = close > 10
plot(flag[1] == false ? 1 : 0)
bool missing = if close > 100
    true
plot(missing == false ? 1 : 0)
bool lazy = close > 10 and ta.sma(close, 2) > 0
plot(lazy ? 1 : 0)
limit = 3
count = 0
for i = 0 to limit
    count := count + 1
    limit := 0
plot(count)
