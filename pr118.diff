+                ui.label(egui::RichText::new(label).color(theme::TEXT_MUTED))
+                    .on_hover_text(explain.to_owned());
+                ui.label(value);
+                ui.end_row();
+            };
+            row(
+                "net P&L",
+                format!("{} pts", fmt_signed_points(report.net_points)),
+                "every closed trade's points, summed",
