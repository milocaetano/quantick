{
  "$defs": {
    "WindowState": {
      "enum": [
        "normal",
        "maximized",
        "minimized"
      ],
      "type": "string"
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "requested": {
      "$ref": "#/$defs/WindowState",
      "description": "Accepted for the next native frame; this is not an OS acknowledgement."
    },
    "window_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/WireU64"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "requested"
  ],
  "title": "WindowResult",
  "type": "object"
}
