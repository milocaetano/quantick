{
  "$defs": {
    "CanonicalDecimal": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
      "type": "string"
    },
    "EditorOperation": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "list",
              "type": "string"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "inspect",
              "type": "string"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "open",
              "type": "string"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "action",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "copy",
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "new_id": {
              "type": "string"
            }
          },
          "required": [
            "action",
            "id",
            "new_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "add_to_chart",
              "type": "string"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "action",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "set_numeric_input",
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/NumericValue"
            }
          },
          "required": [
            "action",
            "id",
            "name",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "replace_source",
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          },
          "required": [
            "action",
            "source"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "save",
              "type": "string"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "close",
              "type": "string"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        }
      ]
    },
    "NumericValue": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "int",
              "type": "string"
            },
            "value": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "float",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/CanonicalDecimal"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "limit": {
      "default": 64,
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "offset": {
      "default": 0,
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "operation": {
      "$ref": "#/$defs/EditorOperation"
    }
  },
  "required": [
    "operation"
  ],
  "title": "EditorInput",
  "type": "object"
}
