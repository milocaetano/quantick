{
  "$defs": {
    "ActionSide": {
      "description": "Which way the order goes.",
      "enum": [
        "buy",
        "sell"
      ],
      "type": "string"
    },
    "CrossDirection": {
      "enum": [
        "up",
        "down"
      ],
      "type": "string"
    },
    "FireAction": {
      "description": "What a firing does.",
      "oneOf": [
        {
          "enum": [
            "alarm"
          ],
          "type": "string"
        },
        {
          "const": "order",
          "description": "A paper market order.",
          "type": "string"
        }
      ]
    },
    "Placement": {
      "description": "Where a script may ring. Prices are decimal strings.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The rectangle drawing `drawing_id` on the pane marks, while its time\nspan covers the bar.",
          "properties": {
            "drawing_id": {
              "$ref": "#/$defs/WireU64"
            },
            "kind": {
              "const": "region",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "drawing_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A fixed band; both edges inside, either order.",
          "properties": {
            "high": {
              "type": "string"
            },
            "kind": {
              "const": "range",
              "type": "string"
            },
            "low": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "low",
            "high"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A horizontal line the bar's body must cross in `direction`.",
          "properties": {
            "direction": {
              "$ref": "#/$defs/CrossDirection"
            },
            "kind": {
              "const": "line",
              "type": "string"
            },
            "level": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "level",
            "direction"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Any closed bar.",
          "properties": {
            "kind": {
              "const": "anywhere",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "ScriptStrategy": {
      "description": "One armed script.",
      "properties": {
        "action": {
          "$ref": "#/$defs/FireAction"
        },
        "alarm_only": {
          "description": "True while `action` is `alarm`: it rings and places nothing.",
          "type": "boolean"
        },
        "disarm_reason": {
          "description": "Why it stopped: `line N: <CODE> <message>` when its script failed at\nruntime, otherwise the disarm reason in the badge's words.",
          "type": [
            "string",
            "null"
          ]
        },
        "gain": {
          "description": "An order's target distance from the entry, in price; `0` places none.\nAbsent for an alarm.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/WireU64",
          "description": "Stable for the tab's session; never reused."
        },
        "pane_id": {
          "$ref": "#/$defs/WireU64"
        },
        "placement": {
          "$ref": "#/$defs/Placement"
        },
        "quantity": {
          "description": "An order's size in the instrument's units, or `ticket` for the\nticket's quantity when the bar closes. Absent for an alarm.",
          "type": [
            "string",
            "null"
          ]
        },
        "script": {
          "type": "string"
        },
        "side": {
          "$ref": "#/$defs/ActionSide"
        },
        "state": {
          "$ref": "#/$defs/ScriptStrategyState"
        },
        "status": {
          "description": "What the last closed bar did, as the instance's badge line says it.",
          "type": "string"
        },
        "stop": {
          "description": "An order's stop distance from the entry, in price; `0` places none.\nAbsent for an alarm.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "pane_id",
        "script",
        "side",
        "placement",
        "state",
        "status",
        "alarm_only",
        "action"
      ],
      "type": "object"
    },
    "ScriptStrategyState": {
      "enum": [
        "watching",
        "disarmed"
      ],
      "type": "string"
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "strategy": {
      "$ref": "#/$defs/ScriptStrategy"
    },
    "tab_id": {
      "$ref": "#/$defs/WireU64"
    }
  },
  "required": [
    "tab_id",
    "strategy"
  ],
  "title": "ArmResult",
  "type": "object"
}
