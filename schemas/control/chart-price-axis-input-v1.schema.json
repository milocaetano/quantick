{
  "$defs": {
    "CanonicalDecimal": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
      "type": "string"
    },
    "PriceAxisMode": {
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Resume the pane's own automatic price fit.",
          "properties": {
            "kind": {
              "const": "auto",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Hold this range until the operator changes or resets it.",
          "properties": {
            "high": {
              "$ref": "#/$defs/CanonicalDecimal"
            },
            "kind": {
              "const": "manual",
              "type": "string"
            },
            "low": {
              "$ref": "#/$defs/CanonicalDecimal"
            }
          },
          "required": [
            "kind",
            "low",
            "high"
          ],
          "type": "object"
        }
      ]
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "mode": {
      "$ref": "#/$defs/PriceAxisMode"
    },
    "pane_id": {
      "$ref": "#/$defs/WireU64"
    },
    "tab_id": {
      "$ref": "#/$defs/WireU64"
    }
  },
  "required": [
    "tab_id",
    "pane_id",
    "mode"
  ],
  "title": "PriceAxisInput",
  "type": "object"
}
