{
  "$defs": {
    "AnnotationBand": {
      "description": "Which value axis of the pane an annotation's anchor prices are read on.\nOmitted: the candles' price axis, so every call written before indicator\nbands existed means what it always meant.",
      "oneOf": [
        {
          "const": "price",
          "description": "The candles' price axis.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "One indicator pane's own value axis, named by the `kind` and `ordinal`\nthe pane's indicators snapshot reports (`native.cvd`, `0`). Anchor\n`price` is then that indicator's value: a CVD level, not a price.",
          "properties": {
            "indicator": {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string"
                },
                "ordinal": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "kind",
                "ordinal"
              ],
              "type": "object"
            }
          },
          "required": [
            "indicator"
          ],
          "type": "object"
        }
      ]
    },
    "BarSpecDto": {
      "properties": {
        "imbalance_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "parameter": {
          "$ref": "#/$defs/CanonicalDecimal"
        },
        "parameter_unit": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "parameter",
        "parameter_unit"
      ],
      "type": "object"
    },
    "CanonicalDecimal": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
      "type": "string"
    },
    "Drawing": {
      "properties": {
        "band": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnnotationBand"
            },
            {
              "type": "null"
            }
          ],
          "description": "The value axis the prices are on: the candles' price axis, or an\nindicator pane's (then a price is that indicator's value). Absent for\na mark of an instant, which has no value axis."
        },
        "hidden": {
          "description": "Hidden by its own eye or by the chart's hide-all.",
          "type": "boolean"
        },
        "id": {
          "$ref": "#/$defs/WireU64"
        },
        "kind": {
          "description": "The drawing tool id (`rectangle`, `trend-line`).",
          "type": "string"
        },
        "locked": {
          "type": "boolean"
        },
        "name": {
          "description": "The trader's name for it, or the one generated when it was placed\n(`zone-1`, `line-2`).",
          "type": [
            "string",
            "null"
          ]
        },
        "prices": {
          "description": "One per anchor, in anchor order; null for an anchor whose price is\nnot a finite number or not representable as a canonical decimal.",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/CanonicalDecimal"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "array"
        },
        "selected": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "prices",
        "selected",
        "locked",
        "hidden"
      ],
      "type": "object"
    },
    "Indicator": {
      "properties": {
        "hidden": {
          "type": "boolean"
        },
        "id": {
          "description": "The native catalog id (`native.ema`) or the script's library name.",
          "type": "string"
        },
        "inputs": {
          "description": "In declaration order.",
          "items": {
            "$ref": "#/$defs/IndicatorInput"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/IndicatorKind"
        },
        "loaded": {
          "description": "Whether the pane runs it without an error.",
          "type": "boolean"
        },
        "slot_id": {
          "$ref": "#/$defs/WireU64"
        }
      },
      "required": [
        "slot_id",
        "kind",
        "id",
        "hidden",
        "loaded",
        "inputs"
      ],
      "type": "object"
    },
    "IndicatorInput": {
      "description": "One input value. A script's saved inputs carry no names, so `name` is\nabsent for them; their order is the script's declaration order.",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "$ref": "#/$defs/Value"
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    },
    "IndicatorKind": {
      "enum": [
        "native",
        "script"
      ],
      "type": "string"
    },
    "Strategy": {
      "properties": {
        "badge": {
          "description": "The badge the chart prints beside the drawing.",
          "type": "string"
        },
        "disarm_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "drawing_id": {
          "$ref": "#/$defs/WireU64"
        },
        "drawing_name": {
          "description": "The name of the drawing it rides; absent when that drawing is gone or\nheld only for another strip layout, so not listed in `drawings`.",
          "type": [
            "string",
            "null"
          ]
        },
        "execution": {
          "description": "`paper` places orders; `alarm_only` only watches.",
          "type": "string"
        },
        "on_break": {
          "description": "`ignore` or `retest_limit`: what a bar cutting through the region does.",
          "type": "string"
        },
        "preset": {
          "type": "string"
        },
        "quantity": {
          "$ref": "#/$defs/CanonicalDecimal"
        },
        "rearm": {
          "description": "`one_shot` or `auto`.",
          "type": "string"
        },
        "side": {
          "description": "`buy` or `sell`.",
          "type": "string"
        },
        "sl_mult": {
          "$ref": "#/$defs/CanonicalDecimal",
          "description": "Stop at this multiple of the trigger bar's projection; zero or less,\nno stop leg."
        },
        "state": {
          "description": "`armed`, `fired`, `retest_resting`, `in_position`, `done` or `disarmed`.",
          "type": "string"
        },
        "tp_mult": {
          "$ref": "#/$defs/CanonicalDecimal",
          "description": "Take profit at this multiple of the trigger bar's projection; zero or\nless, no take-profit leg."
        }
      },
      "required": [
        "drawing_id",
        "preset",
        "side",
        "quantity",
        "tp_mult",
        "sl_mult",
        "on_break",
        "execution",
        "rearm",
        "state",
        "badge"
      ],
      "type": "object"
    },
    "Value": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "int",
              "type": "string"
            },
            "value": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "float",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/CanonicalDecimal"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "bool",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "color",
              "type": "string"
            },
            "value": {
              "items": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "str",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "source",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "bar_spec": {
      "$ref": "#/$defs/BarSpecDto"
    },
    "drawings": {
      "description": "The first [`MAX_DRAWINGS`] this chart's layout shows, back to front;\na mark held only for another strip layout is left out.",
      "items": {
        "$ref": "#/$defs/Drawing"
      },
      "type": "array"
    },
    "drawings_total": {
      "$ref": "#/$defs/WireU64"
    },
    "feed_id": {
      "type": "string"
    },
    "indicators": {
      "description": "The first [`MAX_INDICATORS`], in the pane's order.",
      "items": {
        "$ref": "#/$defs/Indicator"
      },
      "type": "array"
    },
    "indicators_total": {
      "$ref": "#/$defs/WireU64"
    },
    "pane_id": {
      "$ref": "#/$defs/WireU64"
    },
    "strategies": {
      "description": "The first [`MAX_STRATEGIES`], in arming order.",
      "items": {
        "$ref": "#/$defs/Strategy"
      },
      "type": "array"
    },
    "strategies_total": {
      "$ref": "#/$defs/WireU64"
    },
    "symbol": {
      "type": "string"
    },
    "tab_id": {
      "$ref": "#/$defs/WireU64"
    }
  },
  "required": [
    "tab_id",
    "pane_id",
    "feed_id",
    "symbol",
    "bar_spec",
    "indicators",
    "indicators_total",
    "drawings",
    "drawings_total",
    "strategies",
    "strategies_total"
  ],
  "title": "Document",
  "type": "object"
}
