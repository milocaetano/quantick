{
  "$defs": {
    "BarProgressSnapshot": {
      "description": "The forming bar's progress in its rule's own unit.",
      "properties": {
        "done": {
          "$ref": "#/$defs/CanonicalDecimal",
          "description": "What has accumulated: the count, the milliseconds a time bar has run,\nor an imbalance rule's signed running total."
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalDecimal"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where the bar closes; absent for an imbalance rule, which has no\nfixed target."
        },
        "unit": {
          "description": "The unit both figures count in: `ms` for a time rule, else the rule's\nown (`ticks`, a volume or notional unit, an imbalance measure).",
          "type": "string"
        }
      },
      "required": [
        "done",
        "unit"
      ],
      "type": "object"
    },
    "BarSpecDto": {
      "properties": {
        "imbalance_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "parameter": {
          "$ref": "#/$defs/CanonicalDecimal"
        },
        "parameter_unit": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "parameter",
        "parameter_unit"
      ],
      "type": "object"
    },
    "CanonicalDecimal": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
      "type": "string"
    },
    "ChartCoverage": {
      "properties": {
        "newest_close_time_unix_ms": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ],
          "x-unit": "unix_milliseconds"
        },
        "older_history_paging_supported": {
          "type": "boolean"
        },
        "oldest_open_time_unix_ms": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ],
          "x-unit": "unix_milliseconds"
        },
        "venue_candles": {
          "anyOf": [
            {
              "$ref": "#/$defs/VenueCandleStatus"
            },
            {
              "type": "null"
            }
          ],
          "description": "The venue candles the pane's prefix is built from, and whether more\nare on their way; absent for a pane that reads none."
        },
        "venue_prefix_present": {
          "type": "boolean"
        }
      },
      "required": [
        "older_history_paging_supported",
        "venue_prefix_present"
      ],
      "type": "object"
    },
    "ChartPaneSnapshot": {
      "properties": {
        "backfill_boundary_slot": {
          "anyOf": [
            {
              "$ref": "#/$defs/WireU64"
            },
            {
              "type": "null"
            }
          ]
        },
        "bar_progress": {
          "anyOf": [
            {
              "$ref": "#/$defs/BarProgressSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "description": "How far the forming bar is from closing, as the last-price tag prints\nit: a time rule's on the tab's market clock (the replay's playhead\nwhile replaying). Absent with no forming bar to read. Optional on the\nwire, as `uncounted_prints` is."
        },
        "bar_spec": {
          "$ref": "#/$defs/BarSpecDto"
        },
        "closed_bar_count": {
          "$ref": "#/$defs/WireU64"
        },
        "coverage": {
          "$ref": "#/$defs/ChartCoverage"
        },
        "feed_id": {
          "type": "string"
        },
        "focused": {
          "type": "boolean"
        },
        "has_in_progress_bar": {
          "type": "boolean"
        },
        "held_prints": {
          "anyOf": [
            {
              "$ref": "#/$defs/WireU64"
            },
            {
              "type": "null"
            }
          ],
          "description": "Prints the pane's rule holds uncut until they show it its price step\n— a Renko pane's before its first brick. They form the in-progress\nbar. Zero for every rule that reads no step. Optional on the wire, as\n`uncounted_prints` is."
        },
        "inferred_price_step": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalDecimal"
            },
            {
              "type": "null"
            }
          ],
          "description": "The price step the pane's rule read off the pane's own prints and\ncuts on — a Renko pane's, once its prints have shown it. Inferred,\nnever declared by a venue. Absent for a rule that reads no step, and\nfor one still reading it: `held_prints` says how many it holds."
        },
        "off_grid_prints": {
          "anyOf": [
            {
              "$ref": "#/$defs/WireU64"
            },
            {
              "type": "null"
            }
          ],
          "description": "Prints off the price step the pane's rule froze: cut on that step and\ncounted, never snapped onto it. Zero for every rule that freezes none."
        },
        "pagination_revision": {
          "$ref": "#/$defs/WireU64"
        },
        "pane_id": {
          "$ref": "#/$defs/WireU64"
        },
        "pane_index": {
          "$ref": "#/$defs/WireU64",
          "description": "The pane's address within its tab — `0` the flow pane, `1..` the\ncontext stack top to bottom — the number `layout.focus` takes."
        },
        "price_tag_progress": {
          "description": "Whether the last-price tag prints that progress: the setting of the\npane's market (`chart.price_tag.progress.set`). Optional on the wire.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "side": {
          "$ref": "#/$defs/PaneSideDto"
        },
        "symbol": {
          "type": "string"
        },
        "tab_id": {
          "$ref": "#/$defs/WireU64"
        },
        "timeline_revision": {
          "$ref": "#/$defs/WireU64"
        },
        "uncounted_prints": {
          "anyOf": [
            {
              "$ref": "#/$defs/WireU64"
            },
            {
              "type": "null"
            }
          ],
          "description": "Prints the pane's rule could place in no bar — a deal bar's prints\nbefore its first counter reading. Zero for every other rule. The\nnumber the chart-corner chip shows, as data.\nOptional on the wire so v1 readers remain compatible with snapshots\nproduced before deal bars existed."
        },
        "venue_history_bar_count": {
          "$ref": "#/$defs/WireU64"
        },
        "viewport": {
          "$ref": "#/$defs/ViewportSnapshot"
        },
        "visible": {
          "type": "boolean"
        }
      },
      "required": [
        "tab_id",
        "pane_id",
        "side",
        "pane_index",
        "feed_id",
        "symbol",
        "visible",
        "focused",
        "bar_spec",
        "timeline_revision",
        "pagination_revision",
        "closed_bar_count",
        "venue_history_bar_count",
        "has_in_progress_bar",
        "viewport",
        "coverage"
      ],
      "type": "object"
    },
    "DecimalRange": {
      "properties": {
        "high": {
          "$ref": "#/$defs/CanonicalDecimal"
        },
        "low": {
          "$ref": "#/$defs/CanonicalDecimal"
        }
      },
      "required": [
        "low",
        "high"
      ],
      "type": "object"
    },
    "LaneWindowSnapshot": {
      "description": "How wide the live lane's window is, said the way the setting says it. An\n`auto` window follows the recent bars' typical duration, so publishing one\nresolved number would report a measurement as a setting.",
      "properties": {
        "fixed_ms": {
          "description": "Present for `fixed`: the exchange milliseconds shown in the band.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ],
          "x-unit": "milliseconds"
        },
        "mode": {
          "description": "`auto` or `fixed`.",
          "type": "string"
        },
        "zoom": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalDecimal"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present for `auto`: `1.0` fits about one bar's worth of market time.",
          "x-unit": "ratio"
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    },
    "PaneSideDto": {
      "enum": [
        "flow",
        "time"
      ],
      "type": "string"
    },
    "TapeViewSnapshot": {
      "description": "The tape's time frame as a pane reports it.",
      "properties": {
        "end_unix_ms": {
          "description": "The past instant the right edge is held at; absent while it follows\nlive, where the edge is the moving tape clock.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ],
          "x-unit": "unix_milliseconds"
        },
        "follows_live": {
          "description": "The right edge is now. False while the tape is held in the past.",
          "type": "boolean"
        },
        "retained_from_unix_ms": {
          "description": "First instant the retained tape is complete from: a past end cannot\nhold the window further back than half of it before this.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ],
          "x-unit": "unix_milliseconds"
        },
        "window": {
          "$ref": "#/$defs/LaneWindowSnapshot"
        },
        "window_ms": {
          "description": "The market time the tape shows now, resolved.",
          "format": "int64",
          "type": "integer",
          "x-unit": "milliseconds"
        }
      },
      "required": [
        "follows_live",
        "window",
        "window_ms"
      ],
      "type": "object"
    },
    "VenueCandleState": {
      "description": "Where asking the venue for older candles stands.",
      "oneOf": [
        {
          "const": "idle",
          "description": "Nothing out; scrolling near the oldest bar asks for more.",
          "type": "string"
        },
        {
          "const": "loading",
          "description": "A request is out.",
          "type": "string"
        },
        {
          "const": "exhausted",
          "description": "The venue's record starts at the oldest candle held.",
          "type": "string"
        }
      ]
    },
    "VenueCandleStatus": {
      "description": "The venue candles one pane reads.",
      "properties": {
        "candles_held": {
          "$ref": "#/$defs/WireU64"
        },
        "interval_ms": {
          "description": "The interval the candles were asked for at: the pane's own, or the\ncoarser one folded into it.",
          "format": "int64",
          "type": "integer",
          "x-unit": "milliseconds"
        },
        "last_reply_short": {
          "default": false,
          "description": "Whether the last answer was cut short (a failed or throttled fetch):\nthe candles held are real, and more are asked for after a backoff.",
          "type": "boolean"
        },
        "oldest_open_time_unix_ms": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ],
          "x-unit": "unix_milliseconds"
        },
        "state": {
          "$ref": "#/$defs/VenueCandleState"
        }
      },
      "required": [
        "state",
        "interval_ms",
        "candles_held"
      ],
      "type": "object"
    },
    "ViewportSnapshot": {
      "properties": {
        "chart_width_px": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalDecimal"
            },
            {
              "type": "null"
            }
          ],
          "x-unit": "pixels"
        },
        "follows_live": {
          "type": "boolean"
        },
        "geometry_available": {
          "type": "boolean"
        },
        "pixels_per_bar": {
          "$ref": "#/$defs/CanonicalDecimal",
          "x-unit": "pixels_per_bar"
        },
        "price_auto_fit": {
          "type": "boolean"
        },
        "price_axis_inverted": {
          "type": "boolean"
        },
        "price_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecimalRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "right_edge_bar": {
          "$ref": "#/$defs/CanonicalDecimal"
        },
        "tape": {
          "anyOf": [
            {
              "$ref": "#/$defs/TapeViewSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "description": "The native tape's own time frame; absent without a native tape."
        },
        "visible_end_slot_exclusive": {
          "$ref": "#/$defs/WireU64"
        },
        "visible_start_slot": {
          "$ref": "#/$defs/WireU64",
          "description": "The slots the viewport asks the renderer to paint: generous by one bar\nat each edge, so a bar partly off screen is drawn rather than clipped.\nThis is the pane's own notion of \"visible\", not the exact pixel set."
        }
      },
      "required": [
        "geometry_available",
        "visible_start_slot",
        "visible_end_slot_exclusive",
        "pixels_per_bar",
        "right_edge_bar",
        "follows_live",
        "price_auto_fit",
        "price_axis_inverted"
      ],
      "type": "object"
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "panes": {
      "items": {
        "$ref": "#/$defs/ChartPaneSnapshot"
      },
      "type": "array"
    }
  },
  "required": [
    "panes"
  ],
  "title": "ChartSnapshot",
  "type": "object"
}
