{
  "$defs": {
    "CanonicalDecimal": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
      "type": "string"
    },
    "DecimalRange": {
      "properties": {
        "high": {
          "$ref": "#/$defs/CanonicalDecimal"
        },
        "low": {
          "$ref": "#/$defs/CanonicalDecimal"
        }
      },
      "required": [
        "low",
        "high"
      ],
      "type": "object"
    },
    "ViewportSnapshot": {
      "properties": {
        "chart_width_px": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalDecimal"
            },
            {
              "type": "null"
            }
          ],
          "x-unit": "pixels"
        },
        "follows_live": {
          "type": "boolean"
        },
        "geometry_available": {
          "type": "boolean"
        },
        "pixels_per_bar": {
          "$ref": "#/$defs/CanonicalDecimal",
          "x-unit": "pixels_per_bar"
        },
        "price_auto_fit": {
          "type": "boolean"
        },
        "price_axis_inverted": {
          "type": "boolean"
        },
        "price_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecimalRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "right_edge_bar": {
          "$ref": "#/$defs/CanonicalDecimal"
        },
        "visible_end_slot_exclusive": {
          "$ref": "#/$defs/WireU64"
        },
        "visible_start_slot": {
          "$ref": "#/$defs/WireU64",
          "description": "The slots the viewport asks the renderer to paint: generous by one bar\nat each edge, so a bar partly off screen is drawn rather than clipped.\nThis is the pane's own notion of \"visible\", not the exact pixel set."
        }
      },
      "required": [
        "geometry_available",
        "visible_start_slot",
        "visible_end_slot_exclusive",
        "pixels_per_bar",
        "right_edge_bar",
        "follows_live",
        "price_auto_fit",
        "price_axis_inverted"
      ],
      "type": "object"
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "pane_id": {
      "$ref": "#/$defs/WireU64"
    },
    "tab_id": {
      "$ref": "#/$defs/WireU64"
    },
    "viewport": {
      "$ref": "#/$defs/ViewportSnapshot"
    }
  },
  "required": [
    "tab_id",
    "pane_id",
    "viewport"
  ],
  "title": "PriceAxisResult",
  "type": "object"
}
