{
  "$defs": {
    "InstanceId": {
      "description": "Which instance of a tab a call names.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A script, by the id `strategy.script.arm` answered.",
          "properties": {
            "id": {
              "$ref": "#/$defs/WireU64"
            },
            "kind": {
              "const": "script",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Instance `id` riding drawing `drawing_id` on chart `pane_id`, as\n`strategy.desk.list` reports it; never reused in the tab's session.",
          "properties": {
            "drawing_id": {
              "$ref": "#/$defs/WireU64"
            },
            "id": {
              "$ref": "#/$defs/WireU64"
            },
            "kind": {
              "const": "drawing",
              "type": "string"
            },
            "pane_id": {
              "$ref": "#/$defs/WireU64"
            }
          },
          "required": [
            "kind",
            "pane_id",
            "drawing_id",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What a desk command did.",
  "properties": {
    "capability": {
      "description": "The call that ran.",
      "type": "string"
    },
    "changed": {
      "description": "How many instances changed: zero when each already stood as asked.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "created": {
      "anyOf": [
        {
          "$ref": "#/$defs/InstanceId"
        },
        {
          "type": "null"
        }
      ],
      "description": "The copy a duplicate armed, paused."
    },
    "saved_as": {
      "description": "The library file a save wrote.",
      "type": [
        "string",
        "null"
      ]
    },
    "tab_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/WireU64"
        },
        {
          "type": "null"
        }
      ],
      "description": "The tab, absent for an asset call that spans every tab."
    }
  },
  "required": [
    "capability",
    "changed"
  ],
  "title": "CommandResult",
  "type": "object"
}
