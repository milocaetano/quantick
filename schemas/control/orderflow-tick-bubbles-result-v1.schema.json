{
  "$defs": {
    "TickBubblesSnapshot": {
      "properties": {
        "label_min_radius": {
          "type": "string"
        },
        "max_radius": {
          "type": "string"
        },
        "opacity": {
          "type": "string"
        },
        "quantity_unit": {
          "default": "BTC",
          "description": "Denomination of the preset's reference quantity and displayed labels.",
          "type": "string"
        },
        "reference_quantity": {
          "description": "Instrument quantity at the reference radius. Causal bursts keep it fixed;\nlegacy regions raise the common reference for larger visible groups.",
          "type": "string"
        },
        "region_window_ms": {
          "default": "1000",
          "description": "Temporal support of candle regions; does not alter tape grouping.",
          "type": "string"
        },
        "tape_bursts": {
          "anyOf": [
            {
              "$ref": "#/$defs/TickBurstSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "volume_opacity_floor": {
          "description": "Optional fill fraction for small volume, reaching full opacity at reference/4.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "reference_quantity",
        "max_radius",
        "label_min_radius",
        "opacity"
      ],
      "type": "object"
    },
    "TickBurstSnapshot": {
      "properties": {
        "max_radius": {
          "type": "string"
        },
        "price_units_per_pixel": {
          "type": "string"
        },
        "width_px": {
          "type": "string"
        },
        "window_ms": {
          "description": "Independent UTC blocks; a boundary-crossing burst remains two groups.",
          "type": "string"
        }
      },
      "required": [
        "window_ms",
        "width_px",
        "price_units_per_pixel",
        "max_radius"
      ],
      "type": "object"
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "changed": {
      "type": "boolean"
    },
    "pane_id": {
      "$ref": "#/$defs/WireU64"
    },
    "tab_id": {
      "$ref": "#/$defs/WireU64"
    },
    "tick_bubbles": {
      "anyOf": [
        {
          "$ref": "#/$defs/TickBubblesSnapshot"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "tab_id",
    "pane_id",
    "changed"
  ],
  "title": "TickBubblesResult",
  "type": "object"
}
