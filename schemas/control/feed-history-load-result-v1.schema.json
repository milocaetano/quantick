{
  "$defs": {
    "HistoryLoadSnapshot": {
      "description": "One tab's history run, as the History button draws it.",
      "properties": {
        "back_to_unix_ms": {
          "description": "The oldest print held or fetched so far by the run.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ],
          "x-unit": "unix_milliseconds"
        },
        "main_reach": {
          "description": "What the tab's main click loads.",
          "type": "string"
        },
        "pages": {
          "description": "Requests the run has made.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "prints_pulled": {
          "anyOf": [
            {
              "$ref": "#/$defs/WireU64"
            },
            {
              "type": "null"
            }
          ],
          "description": "Prints the run has pulled."
        },
        "reach": {
          "description": "The target being loaded or queued; absent while idle.",
          "type": [
            "string",
            "null"
          ]
        },
        "sessions_reached": {
          "description": "Previous sessions whose open the run has proven on the chart.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "state": {
          "description": "`idle`, `queued`, `loading`, or `paused` (the tab is off screen).",
          "type": "string"
        },
        "traded_ms": {
          "description": "Traded time the run has counted.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ],
          "x-unit": "milliseconds"
        }
      },
      "required": [
        "state",
        "main_reach"
      ],
      "type": "object"
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What a load call did.",
  "properties": {
    "press": {
      "description": "`started`, `queued` (the session is still loading; it starts after),\n`already_running` (a run is paging; nothing new started), or\n`finished` (nothing to fetch: the note says why).",
      "type": "string"
    },
    "reach": {
      "description": "The target, normalised to its token.",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/HistoryLoadSnapshot",
      "description": "The run as `feed.status` reads it right after the call."
    },
    "tab_id": {
      "$ref": "#/$defs/WireU64"
    }
  },
  "required": [
    "tab_id",
    "reach",
    "press",
    "status"
  ],
  "title": "HistoryLoadResult",
  "type": "object"
}
