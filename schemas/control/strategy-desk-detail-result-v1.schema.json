{
  "$defs": {
    "ActionSide": {
      "description": "Which way the order goes.",
      "enum": [
        "buy",
        "sell"
      ],
      "type": "string"
    },
    "CrossDirection": {
      "enum": [
        "up",
        "down"
      ],
      "type": "string"
    },
    "DeclaredInput": {
      "description": "One declared input with the value the instance runs on.",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "type": "object"
    },
    "DeskRow": {
      "description": "One instance as the desk lists it.",
      "properties": {
        "action": {
          "$ref": "#/$defs/FireAction"
        },
        "ended_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "instance": {
          "$ref": "#/$defs/InstanceId"
        },
        "link": {
          "$ref": "#/$defs/Link"
        },
        "name": {
          "description": "The script's file name, or the drawn instance's preset.",
          "type": "string"
        },
        "pane_id": {
          "$ref": "#/$defs/WireU64"
        },
        "state": {
          "$ref": "#/$defs/DeskState"
        },
        "status": {
          "description": "The instance's badge line.",
          "type": "string"
        },
        "tab_id": {
          "$ref": "#/$defs/WireU64"
        }
      },
      "required": [
        "tab_id",
        "pane_id",
        "instance",
        "name",
        "state",
        "link",
        "action",
        "status"
      ],
      "type": "object"
    },
    "DeskState": {
      "oneOf": [
        {
          "enum": [
            "watching"
          ],
          "type": "string"
        },
        {
          "const": "paused",
          "description": "Rings and places nothing, still reading closes.",
          "type": "string"
        },
        {
          "const": "ended",
          "description": "Stopped until `strategy.desk.arm`; `ended_reason` says why.",
          "type": "string"
        }
      ]
    },
    "FireAction": {
      "description": "What a firing does.",
      "oneOf": [
        {
          "enum": [
            "alarm"
          ],
          "type": "string"
        },
        {
          "const": "order",
          "description": "A paper order: drawn strategies only, never a script.",
          "type": "string"
        }
      ]
    },
    "InstanceId": {
      "description": "Which instance of a tab a call names.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A script, by the id `strategy.script.arm` answered.",
          "properties": {
            "id": {
              "$ref": "#/$defs/WireU64"
            },
            "kind": {
              "const": "script",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Instance `id` riding drawing `drawing_id` on chart `pane_id`, as\n`strategy.desk.list` reports it; never reused in the tab's session.",
          "properties": {
            "drawing_id": {
              "$ref": "#/$defs/WireU64"
            },
            "id": {
              "$ref": "#/$defs/WireU64"
            },
            "kind": {
              "const": "drawing",
              "type": "string"
            },
            "pane_id": {
              "$ref": "#/$defs/WireU64"
            }
          },
          "required": [
            "kind",
            "pane_id",
            "drawing_id",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "Link": {
      "oneOf": [
        {
          "description": "It rides the drawing; `name` is the drawing's, when it has one.",
          "properties": {
            "drawing_id": {
              "$ref": "#/$defs/WireU64"
            },
            "kind": {
              "const": "drawing",
              "type": "string"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "drawing_id"
          ],
          "type": "object"
        },
        {
          "description": "A script on a fixed range, a line or anywhere on the chart.",
          "properties": {
            "kind": {
              "const": "chart",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "Placement": {
      "description": "Where a script may ring. Prices are decimal strings.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The rectangle drawing `drawing_id` on the pane marks, while its time\nspan covers the bar.",
          "properties": {
            "drawing_id": {
              "$ref": "#/$defs/WireU64"
            },
            "kind": {
              "const": "region",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "drawing_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A fixed band; both edges inside, either order.",
          "properties": {
            "high": {
              "type": "string"
            },
            "kind": {
              "const": "range",
              "type": "string"
            },
            "low": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "low",
            "high"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A horizontal line the bar's body must cross in `direction`.",
          "properties": {
            "direction": {
              "$ref": "#/$defs/CrossDirection"
            },
            "kind": {
              "const": "line",
              "type": "string"
            },
            "level": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "level",
            "direction"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Any closed bar.",
          "properties": {
            "kind": {
              "const": "anywhere",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "code": {
      "description": "The script's source; none for a drawn instance.",
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "description": "The script's declared title, or the drawn preset's setup in words.",
      "type": "string"
    },
    "fires_today": {
      "description": "Closes it fired on during the UTC day of the tab's latest print.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "history_slots": {
      "description": "The chart's closed slots (from zero, the oldest loaded bar) a fresh\ncopy armed on the oldest fires on, through the live kernel.",
      "items": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "type": "array"
    },
    "inputs": {
      "description": "Read-only: an armed instance runs on these.",
      "items": {
        "$ref": "#/$defs/DeclaredInput"
      },
      "type": "array"
    },
    "placement": {
      "$ref": "#/$defs/Placement",
      "description": "Where it may fire; a drawn instance always rides its region."
    },
    "side": {
      "$ref": "#/$defs/ActionSide"
    },
    "strategy": {
      "$ref": "#/$defs/DeskRow"
    }
  },
  "required": [
    "strategy",
    "description",
    "side",
    "placement",
    "inputs",
    "fires_today",
    "history_slots"
  ],
  "title": "DetailResult",
  "type": "object"
}
