{
  "$defs": {
    "CanonicalDecimal": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
      "type": "string"
    },
    "FootprintSetupSnapshot": {
      "properties": {
        "imbalance_minimum_quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalDecimal"
            },
            {
              "type": "null"
            }
          ],
          "description": "Quantity a level must reach before the ratio is applied at all, so a\none-lot against nothing is not called an imbalance."
        },
        "imbalance_ratio": {
          "$ref": "#/$defs/CanonicalDecimal",
          "description": "A level is imbalanced when one side exceeds the diagonal other side by\nthis factor."
        },
        "show_delta_totals": {
          "type": "boolean"
        },
        "show_numbers": {
          "type": "boolean"
        },
        "show_point_of_control": {
          "type": "boolean"
        },
        "stacked_count": {
          "$ref": "#/$defs/WireU64",
          "description": "Consecutive imbalanced levels that make a stacked zone."
        },
        "style": {
          "description": "`bid_ask`, `delta`, `profile` or `auto` — how each ladder is read.",
          "type": "string"
        }
      },
      "required": [
        "style",
        "imbalance_ratio",
        "stacked_count",
        "show_point_of_control",
        "show_numbers",
        "show_delta_totals"
      ],
      "type": "object"
    },
    "PaneFootprintSnapshot": {
      "properties": {
        "overridden": {
          "description": "True when this chart carries its own footprint setup rather than the\nwindow's shared one.",
          "type": "boolean"
        },
        "pane_id": {
          "$ref": "#/$defs/WireU64"
        },
        "setup": {
          "$ref": "#/$defs/FootprintSetupSnapshot"
        },
        "side": {
          "$ref": "#/$defs/PaneSideDto"
        },
        "visible": {
          "description": "The candle footprint layer is drawn on this chart.",
          "type": "boolean"
        }
      },
      "required": [
        "pane_id",
        "side",
        "visible",
        "overridden",
        "setup"
      ],
      "type": "object"
    },
    "PaneSideDto": {
      "enum": [
        "flow",
        "time"
      ],
      "type": "string"
    },
    "TabFootprintSnapshot": {
      "properties": {
        "panes": {
          "items": {
            "$ref": "#/$defs/PaneFootprintSnapshot"
          },
          "type": "array"
        },
        "tab_id": {
          "$ref": "#/$defs/WireU64"
        }
      },
      "required": [
        "tab_id",
        "panes"
      ],
      "type": "object"
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "tabs": {
      "items": {
        "$ref": "#/$defs/TabFootprintSnapshot"
      },
      "type": "array"
    }
  },
  "required": [
    "tabs"
  ],
  "title": "FootprintSnapshot",
  "type": "object"
}
