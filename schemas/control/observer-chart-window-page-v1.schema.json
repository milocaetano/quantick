{
  "$defs": {
    "BarProvenance": {
      "properties": {
        "aggressor_side": {
          "type": "string"
        },
        "completeness": {
          "type": "string"
        },
        "price": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "trade_count": {
          "type": "string"
        },
        "volume": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "completeness",
        "price",
        "volume",
        "aggressor_side",
        "trade_count"
      ],
      "type": "object"
    },
    "BarSnapshot": {
      "properties": {
        "buy_volume": {
          "$ref": "#/$defs/CanonicalDecimal"
        },
        "close": {
          "$ref": "#/$defs/CanonicalDecimal"
        },
        "close_time_unix_ms": {
          "format": "int64",
          "type": "integer",
          "x-unit": "unix_milliseconds"
        },
        "delta": {
          "$ref": "#/$defs/CanonicalDecimal"
        },
        "high": {
          "$ref": "#/$defs/CanonicalDecimal"
        },
        "low": {
          "$ref": "#/$defs/CanonicalDecimal"
        },
        "open": {
          "$ref": "#/$defs/CanonicalDecimal"
        },
        "open_time_unix_ms": {
          "format": "int64",
          "type": "integer",
          "x-unit": "unix_milliseconds"
        },
        "provenance": {
          "$ref": "#/$defs/BarProvenance"
        },
        "sell_volume": {
          "$ref": "#/$defs/CanonicalDecimal"
        },
        "slot": {
          "$ref": "#/$defs/WireU64"
        },
        "state": {
          "$ref": "#/$defs/BarStateDto"
        },
        "trade_count": {
          "$ref": "#/$defs/WireU64"
        },
        "volume": {
          "$ref": "#/$defs/CanonicalDecimal"
        }
      },
      "required": [
        "slot",
        "state",
        "open_time_unix_ms",
        "close_time_unix_ms",
        "open",
        "high",
        "low",
        "close",
        "volume",
        "buy_volume",
        "sell_volume",
        "delta",
        "trade_count",
        "provenance"
      ],
      "type": "object"
    },
    "BarStateDto": {
      "enum": [
        "closed",
        "in_progress"
      ],
      "type": "string"
    },
    "CanonicalDecimal": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
      "type": "string"
    },
    "ChartBarPage": {
      "properties": {
        "has_more": {
          "type": "boolean"
        },
        "item_count": {
          "format": "uint",
          "maximum": 32,
          "minimum": 0,
          "type": "integer"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/BarSnapshot"
          },
          "maxItems": 32,
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/PageCursor"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "item_count",
        "has_more"
      ],
      "type": "object"
    },
    "DecimalRange": {
      "properties": {
        "high": {
          "$ref": "#/$defs/CanonicalDecimal"
        },
        "low": {
          "$ref": "#/$defs/CanonicalDecimal"
        }
      },
      "required": [
        "low",
        "high"
      ],
      "type": "object"
    },
    "InstanceId": {
      "description": "The identity of one running Quantick instance.",
      "maxLength": 22,
      "minLength": 22,
      "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$",
      "type": "string"
    },
    "LaneWindowSnapshot": {
      "description": "How wide the live lane's window is, said the way the setting says it. An\n`auto` window follows the recent bars' typical duration, so publishing one\nresolved number would report a measurement as a setting.",
      "properties": {
        "fixed_ms": {
          "description": "Present for `fixed`: the exchange milliseconds shown in the band.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ],
          "x-unit": "milliseconds"
        },
        "mode": {
          "description": "`auto` or `fixed`.",
          "type": "string"
        },
        "zoom": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalDecimal"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present for `auto`: `1.0` fits about one bar's worth of market time.",
          "x-unit": "ratio"
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    },
    "ModuleId": {
      "description": "A module contributing control-plane behavior.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,7}$",
      "type": "string"
    },
    "PageCursor": {
      "properties": {
        "consistency_mode": {
          "$ref": "#/$defs/PaginationConsistency"
        },
        "consistency_revision": {
          "$ref": "#/$defs/WireU64"
        },
        "high_water_position": {
          "anyOf": [
            {
              "$ref": "#/$defs/WireU64"
            },
            {
              "type": "null"
            }
          ]
        },
        "instance_id": {
          "$ref": "#/$defs/InstanceId"
        },
        "next_position": {
          "$ref": "#/$defs/WireU64"
        },
        "query_digest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "resource_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceId"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope_id": {
          "$ref": "#/$defs/SnapshotScopeId"
        }
      },
      "required": [
        "instance_id",
        "scope_id",
        "query_digest",
        "consistency_mode",
        "consistency_revision",
        "next_position"
      ],
      "type": "object"
    },
    "PaginationConsistency": {
      "enum": [
        "revision_locked",
        "append_only",
        "retained_resource"
      ],
      "type": "string"
    },
    "PaneSideDto": {
      "enum": [
        "flow",
        "time"
      ],
      "type": "string"
    },
    "ResourceId": {
      "description": "A retained immutable resource identity.",
      "maxLength": 22,
      "minLength": 22,
      "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$",
      "type": "string"
    },
    "Sha256Digest": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "SnapshotScopeId": {
      "description": "A namespaced semantic snapshot projection.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,7}$",
      "type": "string"
    },
    "TapeViewSnapshot": {
      "description": "The tape's time frame as a pane reports it.",
      "properties": {
        "end_unix_ms": {
          "description": "The past instant the right edge is held at; absent while it follows\nlive, where the edge is the moving tape clock.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ],
          "x-unit": "unix_milliseconds"
        },
        "follows_live": {
          "description": "The right edge is now. False while the tape is held in the past.",
          "type": "boolean"
        },
        "retained_from_unix_ms": {
          "description": "First instant the retained tape is complete from: a past end cannot\nhold the window further back than half of it before this.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ],
          "x-unit": "unix_milliseconds"
        },
        "window": {
          "$ref": "#/$defs/LaneWindowSnapshot"
        },
        "window_ms": {
          "description": "The market time the tape shows now, resolved.",
          "format": "int64",
          "type": "integer",
          "x-unit": "milliseconds"
        }
      },
      "required": [
        "follows_live",
        "window",
        "window_ms"
      ],
      "type": "object"
    },
    "ViewportSnapshot": {
      "properties": {
        "chart_width_px": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalDecimal"
            },
            {
              "type": "null"
            }
          ],
          "x-unit": "pixels"
        },
        "follows_live": {
          "type": "boolean"
        },
        "geometry_available": {
          "type": "boolean"
        },
        "pixels_per_bar": {
          "$ref": "#/$defs/CanonicalDecimal",
          "x-unit": "pixels_per_bar"
        },
        "price_auto_fit": {
          "type": "boolean"
        },
        "price_axis_inverted": {
          "type": "boolean"
        },
        "price_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecimalRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "right_edge_bar": {
          "$ref": "#/$defs/CanonicalDecimal"
        },
        "tape": {
          "anyOf": [
            {
              "$ref": "#/$defs/TapeViewSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "description": "The native tape's own time frame; absent without a native tape."
        },
        "visible_end_slot_exclusive": {
          "$ref": "#/$defs/WireU64"
        },
        "visible_start_slot": {
          "$ref": "#/$defs/WireU64",
          "description": "The slots the viewport asks the renderer to paint: generous by one bar\nat each edge, so a bar partly off screen is drawn rather than clipped.\nThis is the pane's own notion of \"visible\", not the exact pixel set."
        }
      },
      "required": [
        "geometry_available",
        "visible_start_slot",
        "visible_end_slot_exclusive",
        "pixels_per_bar",
        "right_edge_bar",
        "follows_live",
        "price_auto_fit",
        "price_axis_inverted"
      ],
      "type": "object"
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "bars": {
      "$ref": "#/$defs/ChartBarPage"
    },
    "captured_at_unix_ms": {
      "format": "int64",
      "type": "integer",
      "x-unit": "unix_milliseconds"
    },
    "consistency_revision": {
      "$ref": "#/$defs/WireU64"
    },
    "feed_id": {
      "type": "string"
    },
    "high_water_slot_exclusive": {
      "$ref": "#/$defs/WireU64"
    },
    "in_progress_bar": {
      "anyOf": [
        {
          "$ref": "#/$defs/BarSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "omitted_modules": {
      "items": {
        "$ref": "#/$defs/ModuleId"
      },
      "type": "array"
    },
    "pane_id": {
      "$ref": "#/$defs/WireU64"
    },
    "side": {
      "$ref": "#/$defs/PaneSideDto"
    },
    "symbol": {
      "type": "string"
    },
    "tab_id": {
      "$ref": "#/$defs/WireU64"
    },
    "viewport": {
      "$ref": "#/$defs/ViewportSnapshot"
    }
  },
  "required": [
    "captured_at_unix_ms",
    "tab_id",
    "pane_id",
    "side",
    "feed_id",
    "symbol",
    "consistency_revision",
    "high_water_slot_exclusive",
    "viewport",
    "bars",
    "omitted_modules"
  ],
  "title": "ChartWindowPage",
  "type": "object"
}
