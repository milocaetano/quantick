{
  "$defs": {
    "EventCursor": {
      "properties": {
        "instance_id": {
          "$ref": "#/$defs/InstanceId"
        },
        "next_sequence": {
          "$ref": "#/$defs/WireU64"
        }
      },
      "required": [
        "instance_id",
        "next_sequence"
      ],
      "type": "object"
    },
    "EventStart": {
      "enum": [
        "oldest",
        "latest"
      ],
      "type": "string"
    },
    "InstanceId": {
      "description": "The identity of one running Quantick instance.",
      "maxLength": 22,
      "minLength": 22,
      "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$",
      "type": "string"
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`events.wait`: the same position, plus how long to wait for it to move.",
  "properties": {
    "cursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/EventCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "limit": {
      "format": "uint",
      "maximum": 256,
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "start": {
      "anyOf": [
        {
          "$ref": "#/$defs/EventStart"
        },
        {
          "type": "null"
        }
      ]
    },
    "timeout_ms": {
      "format": "uint64",
      "maximum": 30000,
      "minimum": 1,
      "type": "integer",
      "x-unit": "milliseconds"
    }
  },
  "required": [
    "timeout_ms"
  ],
  "title": "EventsWaitInput",
  "type": "object"
}
