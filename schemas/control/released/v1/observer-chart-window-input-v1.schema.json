{
  "$defs": {
    "ChartWindowQuery": {
      "properties": {
        "page_size": {
          "format": "uint",
          "maximum": 32,
          "minimum": 1,
          "type": "integer"
        },
        "pane_id": {
          "$ref": "#/$defs/WireU64"
        },
        "range": {
          "$ref": "#/$defs/ChartWindowRange"
        },
        "tab_id": {
          "$ref": "#/$defs/WireU64"
        }
      },
      "required": [
        "tab_id",
        "pane_id",
        "range",
        "page_size"
      ],
      "type": "object"
    },
    "ChartWindowRange": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "visible",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "end_slot_exclusive": {
              "$ref": "#/$defs/WireU64"
            },
            "kind": {
              "const": "slots",
              "type": "string"
            },
            "start_slot": {
              "$ref": "#/$defs/WireU64"
            }
          },
          "required": [
            "kind",
            "start_slot",
            "end_slot_exclusive"
          ],
          "type": "object"
        }
      ]
    },
    "InstanceId": {
      "description": "The identity of one running Quantick instance.",
      "maxLength": 22,
      "minLength": 22,
      "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$",
      "type": "string"
    },
    "PageCursor": {
      "properties": {
        "consistency_mode": {
          "$ref": "#/$defs/PaginationConsistency"
        },
        "consistency_revision": {
          "$ref": "#/$defs/WireU64"
        },
        "high_water_position": {
          "anyOf": [
            {
              "$ref": "#/$defs/WireU64"
            },
            {
              "type": "null"
            }
          ]
        },
        "instance_id": {
          "$ref": "#/$defs/InstanceId"
        },
        "next_position": {
          "$ref": "#/$defs/WireU64"
        },
        "query_digest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "resource_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceId"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope_id": {
          "$ref": "#/$defs/SnapshotScopeId"
        }
      },
      "required": [
        "instance_id",
        "scope_id",
        "query_digest",
        "consistency_mode",
        "consistency_revision",
        "next_position"
      ],
      "type": "object"
    },
    "PaginationConsistency": {
      "enum": [
        "revision_locked",
        "append_only",
        "retained_resource"
      ],
      "type": "string"
    },
    "ResourceId": {
      "description": "A retained immutable resource identity.",
      "maxLength": 22,
      "minLength": 22,
      "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$",
      "type": "string"
    },
    "Sha256Digest": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "SnapshotScopeId": {
      "description": "A namespaced semantic snapshot projection.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,7}$",
      "type": "string"
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/PageCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "query": {
      "$ref": "#/$defs/ChartWindowQuery"
    }
  },
  "required": [
    "query"
  ],
  "title": "ChartWindowInput",
  "type": "object"
}
