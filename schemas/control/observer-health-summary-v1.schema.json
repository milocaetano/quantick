{
  "$defs": {
    "CanonicalDecimal": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
      "type": "string"
    },
    "FrameHealthSnapshot": {
      "properties": {
        "cpu_average_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalDecimal"
            },
            {
              "type": "null"
            }
          ],
          "x-unit": "milliseconds"
        },
        "cpu_worst_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalDecimal"
            },
            {
              "type": "null"
            }
          ],
          "x-unit": "milliseconds"
        },
        "frames_per_second": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalDecimal"
            },
            {
              "type": "null"
            }
          ],
          "x-unit": "frames_per_second"
        },
        "wall_average_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalDecimal"
            },
            {
              "type": "null"
            }
          ],
          "x-unit": "milliseconds"
        },
        "wall_worst_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalDecimal"
            },
            {
              "type": "null"
            }
          ],
          "x-unit": "milliseconds"
        }
      },
      "type": "object"
    },
    "IndicatorIssueSnapshot": {
      "properties": {
        "bar_index": {
          "anyOf": [
            {
              "$ref": "#/$defs/WireU64"
            },
            {
              "type": "null"
            }
          ]
        },
        "detail": {
          "type": "string"
        },
        "slot_id": {
          "$ref": "#/$defs/WireU64"
        },
        "source_kind": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "user_text_redacted": {
          "type": "boolean"
        }
      },
      "required": [
        "slot_id",
        "source_kind",
        "state",
        "detail",
        "user_text_redacted"
      ],
      "type": "object"
    },
    "LoadingTaskSnapshot": {
      "properties": {
        "operation_count": {
          "$ref": "#/$defs/WireU64"
        },
        "task": {
          "type": "string"
        }
      },
      "required": [
        "task",
        "operation_count"
      ],
      "type": "object"
    },
    "OrderflowHealthSnapshot": {
      "properties": {
        "active_levels": {
          "$ref": "#/$defs/WireU64"
        },
        "aggression_count": {
          "$ref": "#/$defs/WireU64"
        },
        "archived_runs": {
          "$ref": "#/$defs/WireU64"
        },
        "arrival_latency_ms": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ],
          "x-unit": "milliseconds"
        },
        "ask_levels": {
          "$ref": "#/$defs/WireU64"
        },
        "bid_levels": {
          "$ref": "#/$defs/WireU64"
        },
        "config_revision": {
          "$ref": "#/$defs/WireU64"
        },
        "depth_updates": {
          "$ref": "#/$defs/WireU64"
        },
        "depth_updates_since_summary": {
          "$ref": "#/$defs/WireU64"
        },
        "dropped_cells": {
          "$ref": "#/$defs/WireU64"
        },
        "dropped_liquidity_events": {
          "$ref": "#/$defs/WireU64"
        },
        "effective_grouping_multiple": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "effective_price_grouping": {
          "$ref": "#/$defs/CanonicalDecimal"
        },
        "enabled": {
          "type": "boolean"
        },
        "floored_quantity": {
          "$ref": "#/$defs/CanonicalDecimal",
          "description": "Exact quantity the trader's own display floor kept off the canvas."
        },
        "folded_aggressions": {
          "$ref": "#/$defs/WireU64",
          "description": "Aggressions the projection budget folded into a neighbour instead of\ndrawing alone. Folded, not dropped: the quantity is still on the canvas."
        },
        "gaps": {
          "$ref": "#/$defs/WireU64"
        },
        "generation": {
          "anyOf": [
            {
              "$ref": "#/$defs/WireU64"
            },
            {
              "type": "null"
            }
          ]
        },
        "history_bytes": {
          "$ref": "#/$defs/WireU64",
          "x-unit": "bytes"
        },
        "last_event_unix_ms": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ],
          "x-unit": "unix_milliseconds"
        },
        "last_snapshot_observed_unix_ms": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ],
          "x-unit": "unix_milliseconds"
        },
        "last_update_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/WireU64"
            },
            {
              "type": "null"
            }
          ]
        },
        "live_projection_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalDecimal"
            },
            {
              "type": "null"
            }
          ],
          "x-unit": "milliseconds"
        },
        "projection_aggressions": {
          "$ref": "#/$defs/WireU64"
        },
        "projection_builds": {
          "$ref": "#/$defs/WireU64"
        },
        "projection_cache_hits": {
          "$ref": "#/$defs/WireU64"
        },
        "projection_cells": {
          "$ref": "#/$defs/WireU64"
        },
        "projection_liquidity_events": {
          "$ref": "#/$defs/WireU64"
        },
        "projection_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalDecimal"
            },
            {
              "type": "null"
            }
          ],
          "x-unit": "milliseconds"
        },
        "snapshots": {
          "$ref": "#/$defs/WireU64"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "status",
        "bid_levels",
        "ask_levels",
        "active_levels",
        "archived_runs",
        "aggression_count",
        "history_bytes",
        "projection_cells",
        "projection_aggressions",
        "projection_liquidity_events",
        "dropped_cells",
        "folded_aggressions",
        "floored_quantity",
        "dropped_liquidity_events",
        "effective_price_grouping",
        "effective_grouping_multiple",
        "projection_builds",
        "projection_cache_hits",
        "config_revision",
        "depth_updates",
        "depth_updates_since_summary",
        "snapshots",
        "gaps"
      ],
      "type": "object"
    },
    "PaneHealthSnapshot": {
      "properties": {
        "indicator_count": {
          "$ref": "#/$defs/WireU64"
        },
        "indicator_error_count": {
          "$ref": "#/$defs/WireU64"
        },
        "indicator_issues": {
          "items": {
            "$ref": "#/$defs/IndicatorIssueSnapshot"
          },
          "type": "array"
        },
        "indicator_stale_count": {
          "$ref": "#/$defs/WireU64"
        },
        "orderflow": {
          "anyOf": [
            {
              "$ref": "#/$defs/OrderflowHealthSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "pane_id": {
          "$ref": "#/$defs/WireU64"
        },
        "side": {
          "$ref": "#/$defs/PaneSideDto"
        }
      },
      "required": [
        "pane_id",
        "side",
        "indicator_count",
        "indicator_error_count",
        "indicator_stale_count",
        "indicator_issues"
      ],
      "type": "object"
    },
    "PaneSideDto": {
      "enum": [
        "flow",
        "time"
      ],
      "type": "string"
    },
    "TabHealthSnapshot": {
      "properties": {
        "active_loading_tasks": {
          "items": {
            "$ref": "#/$defs/LoadingTaskSnapshot"
          },
          "type": "array"
        },
        "panes": {
          "items": {
            "$ref": "#/$defs/PaneHealthSnapshot"
          },
          "type": "array"
        },
        "tab_id": {
          "$ref": "#/$defs/WireU64"
        },
        "tape": {
          "anyOf": [
            {
              "$ref": "#/$defs/TapeHealthSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "description": "How late this tab's tape is, and where the time is going. `None` while\nreplaying — a recording's prints are as old as the day they were\ncaptured and the playback clock decides when they appear."
        }
      },
      "required": [
        "tab_id",
        "active_loading_tasks",
        "panes"
      ],
      "type": "object"
    },
    "TapeHealthSnapshot": {
      "description": "Where a tab's tape delay is being spent.\n\nThe whole point of the breakdown is that \"the chart is eighteen seconds\nbehind\" is not actionable on its own: it reads the same whether the venue's\nadapter was late, the wire was late, or this process drained late, and those\nhave different fixes. An investigation that starts here can name the hop\nwithout a screenshot and without a person watching the corner of a window.",
      "properties": {
        "arrival_latency_ms": {
          "description": "Newest print: venue stamp to this chart drawing it. The end-to-end\nfigure the status bar shows.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ],
          "x-unit": "milliseconds"
        },
        "dominant_hop": {
          "description": "The provider's own name for the hop that owns most of the delay.",
          "type": [
            "string",
            "null"
          ]
        },
        "feed_arrival_latency_ms": {
          "description": "The same measurement taken where the feed read the print off the wire,\none hop earlier.\n\nThe gap between this and `arrival_latency_ms` is what quantick's own\nqueue and frame drain cost. It is a *derived* reading, not a measured\none — the two are sampled at different instants — but a gap of seconds\nbetween them is unambiguous, and it is the only way to see that hop at\nall. `None` on a provider that cannot cut its own chain.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ],
          "x-unit": "milliseconds"
        },
        "feed_arrival_latency_peak_ms": {
          "description": "The worst end-to-end figure over the sampled prints, at the feed.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ],
          "x-unit": "milliseconds"
        },
        "sampled_prints": {
          "$ref": "#/$defs/WireU64",
          "description": "How many live prints the split covers."
        },
        "source_latency_ms": {
          "description": "Venue stamp to the source handing the print over: everything upstream\nof quantick.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ],
          "x-unit": "milliseconds"
        },
        "transport_latency_ms": {
          "description": "The source handing it over to quantick reading it: the wire.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ],
          "x-unit": "milliseconds"
        },
        "transport_latency_peak_ms": {
          "description": "The worst wire figure over the sampled prints.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ],
          "x-unit": "milliseconds"
        }
      },
      "required": [
        "sampled_prints"
      ],
      "type": "object"
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "frame": {
      "$ref": "#/$defs/FrameHealthSnapshot"
    },
    "tabs": {
      "items": {
        "$ref": "#/$defs/TabHealthSnapshot"
      },
      "type": "array"
    }
  },
  "required": [
    "frame",
    "tabs"
  ],
  "title": "HealthSnapshot",
  "type": "object"
}
