{
  "$defs": {
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Move one context chart within the stack.",
  "properties": {
    "from": {
      "$ref": "#/$defs/WireU64",
      "description": "The pane's address now. `0` is the flow pane and cannot be moved."
    },
    "tab_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/WireU64"
        },
        {
          "type": "null"
        }
      ],
      "description": "The tab's id, as `observe.workspace` reports it."
    },
    "to": {
      "$ref": "#/$defs/WireU64",
      "description": "Where it should sit."
    }
  },
  "required": [
    "from",
    "to"
  ],
  "title": "MovePaneInput",
  "type": "object"
}
