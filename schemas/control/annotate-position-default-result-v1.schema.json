{
  "$defs": {
    "CanonicalDecimal": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
      "type": "string"
    },
    "PositionLook": {
      "description": "A position's look: what its bar shows and a saved default carries.",
      "properties": {
        "custom": {
          "description": "Whether the ratio is none of the menu's presets (1, 2, 3).",
          "type": "boolean"
        },
        "ratio": {
          "$ref": "#/$defs/CanonicalDecimal",
          "description": "Reward per unit of risk."
        },
        "ratio_text": {
          "description": "The bar button's words, risk first: `R/R 1:2`, `R/R 1:1.3`.",
          "type": "string"
        },
        "stop_color": {
          "type": "string"
        },
        "target_color": {
          "type": "string"
        },
        "zone_opacity_pct": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "target_color",
        "stop_color",
        "zone_opacity_pct",
        "ratio",
        "custom",
        "ratio_text"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "opening": {
      "$ref": "#/$defs/PositionLook",
      "description": "What a new position of this tool opens with on this pane's ground."
    },
    "saved": {
      "description": "Whether a saved default stands, rather than the factory look.",
      "type": "boolean"
    },
    "tool_id": {
      "description": "`long-position` or `short-position`: each keeps its own default.",
      "type": "string"
    }
  },
  "required": [
    "tool_id",
    "opening",
    "saved"
  ],
  "title": "PositionDefaultResult",
  "type": "object"
}
