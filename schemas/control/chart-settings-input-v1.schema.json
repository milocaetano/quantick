{
  "$defs": {
    "ChartSettingsTab": {
      "description": "A tab of the chart settings window.",
      "oneOf": [
        {
          "const": "candles",
          "description": "Candle and canvas appearance, with its presets.",
          "type": "string"
        },
        {
          "const": "footprint",
          "description": "The focused chart's footprint knobs, with their presets.",
          "type": "string"
        }
      ]
    },
    "ChartSettingsTarget": {
      "additionalProperties": false,
      "description": "Stable runtime address, published by chart.summary. Both IDs must still exist.",
      "properties": {
        "pane_id": {
          "$ref": "#/$defs/WireU64"
        },
        "tab_id": {
          "$ref": "#/$defs/WireU64"
        }
      },
      "required": [
        "tab_id",
        "pane_id"
      ],
      "type": "object"
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One thing to do with the window or its candle presets.",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "Put the window on screen at `tab`. Opening starts a sitting: the\nappearance at that moment is what `reset_candles` returns to.",
      "properties": {
        "action": {
          "const": "open",
          "type": "string"
        },
        "tab": {
          "$ref": "#/$defs/ChartSettingsTab"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChartSettingsTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "action",
        "tab"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Take the window off screen and end the sitting.",
      "properties": {
        "action": {
          "const": "close",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Apply a built-in candle preset (by label or snake_case value) or a\nsaved one (by name). A built-in changes the candles and keeps the\ncanvas; a saved one brings back candles and canvas.",
      "properties": {
        "action": {
          "const": "apply_candle_preset",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChartSettingsTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "action",
        "name"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Save the chart's current look under `name`, replacing a saved look of\nthat name. Built-in names are refused.",
      "properties": {
        "action": {
          "const": "save_candle_preset",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChartSettingsTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "action",
        "name"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Forget a saved look. Built-ins cannot be deleted.",
      "properties": {
        "action": {
          "const": "delete_candle_preset",
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "name"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Restore the appearance the window opened on. Refused while the window\nis closed: there is no sitting to return to.",
      "properties": {
        "action": {
          "const": "reset_candles",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChartSettingsTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Inspect the effective local style and its per-field ownership.",
      "properties": {
        "action": {
          "const": "inspect",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChartSettingsTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Replace one pane's full style document, as returned by inspect. Invalid or\nunknown fields, non-finite values and out-of-range geometry are refused atomically.",
      "properties": {
        "action": {
          "const": "update_candles",
          "type": "string"
        },
        "style": {
          "additionalProperties": false,
          "description": "One pane's candle/canvas style: read effective_style, edit values and ownership, submit it whole to update_candles. Geometry and opacity are canonical decimal strings in inclusive bounds.",
          "properties": {
            "candles": {
              "additionalProperties": false,
              "properties": {
                "bear_fill": {
                  "description": "sRGB red, green and blue byte values, in that order.",
                  "items": {
                    "maximum": 255,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": "array"
                },
                "bear_outline": {
                  "description": "sRGB red, green and blue byte values, in that order.",
                  "items": {
                    "maximum": 255,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": "array"
                },
                "body_width_frac": {
                  "description": "Decimal [0.1, 1], inclusive.",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                  "type": "string"
                },
                "bull_fill": {
                  "description": "sRGB red, green and blue byte values, in that order.",
                  "items": {
                    "maximum": 255,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": "array"
                },
                "bull_outline": {
                  "description": "sRGB red, green and blue byte values, in that order.",
                  "items": {
                    "maximum": 255,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": "array"
                },
                "corner_radius": {
                  "description": "Decimal [0, 8], inclusive.",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                  "type": "string"
                },
                "custom_wick_color": {
                  "type": "boolean"
                },
                "fill_opacity": {
                  "description": "Decimal [0, 1], inclusive.",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                  "type": "string"
                },
                "forming_opacity": {
                  "description": "Decimal [0, 1], inclusive.",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                  "type": "string"
                },
                "gap_px": {
                  "description": "Decimal [0, 8], inclusive.",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                  "type": "string"
                },
                "min_body_height": {
                  "description": "Decimal [1, 12], inclusive.",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                  "type": "string"
                },
                "outline_only": {
                  "type": "boolean"
                },
                "outline_opacity": {
                  "description": "Decimal [0, 1], inclusive.",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                  "type": "string"
                },
                "outline_width": {
                  "description": "Decimal [0.5, 4], inclusive.",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                  "type": "string"
                },
                "show_wicks": {
                  "type": "boolean"
                },
                "wick": {
                  "description": "sRGB red, green and blue byte values, in that order.",
                  "items": {
                    "maximum": 255,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": "array"
                },
                "wick_opacity": {
                  "description": "Decimal [0, 1], inclusive.",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                  "type": "string"
                },
                "wick_width": {
                  "description": "Decimal [0.5, 4], inclusive.",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                  "type": "string"
                }
              },
              "required": [
                "outline_only",
                "bull_fill",
                "bear_fill",
                "bull_outline",
                "bear_outline",
                "fill_opacity",
                "outline_opacity",
                "outline_width",
                "show_wicks",
                "custom_wick_color",
                "wick",
                "wick_opacity",
                "wick_width",
                "body_width_frac",
                "gap_px",
                "corner_radius",
                "min_body_height",
                "forming_opacity"
              ],
              "type": "object"
            },
            "canvas": {
              "additionalProperties": false,
              "properties": {
                "background": {
                  "description": "sRGB red, green and blue byte values, in that order.",
                  "items": {
                    "maximum": 255,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": "array"
                },
                "background_enabled": {
                  "type": "boolean"
                },
                "grid": {
                  "description": "sRGB red, green and blue byte values, in that order.",
                  "items": {
                    "maximum": 255,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": "array"
                },
                "grid_enabled": {
                  "type": "boolean"
                },
                "grid_opacity": {
                  "description": "Decimal [0, 1], inclusive.",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                  "type": "string"
                },
                "time_grid_enabled": {
                  "type": "boolean"
                }
              },
              "required": [
                "background_enabled",
                "background",
                "grid_enabled",
                "grid",
                "grid_opacity"
              ],
              "type": "object"
            },
            "ownership": {
              "additionalProperties": false,
              "description": "Theme follows the chart's theme; explicit keeps the value across themes. Omitted markers are explicit; inspect returns all.",
              "properties": {
                "background": {
                  "enum": [
                    "theme",
                    "explicit"
                  ],
                  "type": "string"
                },
                "bear_fill": {
                  "enum": [
                    "theme",
                    "explicit"
                  ],
                  "type": "string"
                },
                "bear_outline": {
                  "enum": [
                    "theme",
                    "explicit"
                  ],
                  "type": "string"
                },
                "bull_fill": {
                  "enum": [
                    "theme",
                    "explicit"
                  ],
                  "type": "string"
                },
                "bull_outline": {
                  "enum": [
                    "theme",
                    "explicit"
                  ],
                  "type": "string"
                },
                "fill_opacity": {
                  "enum": [
                    "theme",
                    "explicit"
                  ],
                  "type": "string"
                },
                "grid": {
                  "enum": [
                    "theme",
                    "explicit"
                  ],
                  "type": "string"
                },
                "outline_opacity": {
                  "enum": [
                    "theme",
                    "explicit"
                  ],
                  "type": "string"
                },
                "outline_width": {
                  "enum": [
                    "theme",
                    "explicit"
                  ],
                  "type": "string"
                },
                "time_grid": {
                  "enum": [
                    "theme",
                    "explicit"
                  ],
                  "type": "string"
                },
                "wick": {
                  "enum": [
                    "theme",
                    "explicit"
                  ],
                  "type": "string"
                },
                "wick_opacity": {
                  "enum": [
                    "theme",
                    "explicit"
                  ],
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          "required": [
            "candles",
            "canvas"
          ],
          "type": "object"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChartSettingsTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "action",
        "style"
      ],
      "type": "object"
    }
  ],
  "title": "ChartSettingsInput"
}
