{
  "$defs": {
    "SnapshotScopeId": {
      "description": "A namespaced semantic snapshot projection.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,7}$",
      "type": "string"
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "scopes": {
      "items": {
        "$ref": "#/$defs/SnapshotScopeId"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
    },
    "window_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/WireU64"
        },
        {
          "type": "null"
        }
      ],
      "description": "Live native market window, pinned once when this read reaches the UI thread.\nOmission selects the focused live window at that admission point."
    }
  },
  "required": [
    "scopes"
  ],
  "title": "SnapshotReadInput",
  "type": "object"
}
