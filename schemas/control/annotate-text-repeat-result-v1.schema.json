{
  "$defs": {
    "CanonicalDecimal": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
      "type": "string"
    },
    "Family": {
      "enum": [
        "proportional",
        "monospace"
      ],
      "type": "string"
    },
    "TextProperties": {
      "additionalProperties": false,
      "properties": {
        "background": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": [
            "array",
            "null"
          ]
        },
        "bold": {
          "type": "boolean"
        },
        "border": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": [
            "array",
            "null"
          ]
        },
        "color": {
          "description": "Straight RGBA bytes.",
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "family": {
          "$ref": "#/$defs/Family"
        },
        "italic": {
          "type": "boolean"
        },
        "size_px": {
          "$ref": "#/$defs/CanonicalDecimal",
          "description": "Canonical decimal string from 6 through 72 screen pixels, inclusive."
        },
        "wrap_width_px": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalDecimal"
            },
            {
              "type": "null"
            }
          ],
          "description": "Canonical decimal string from 40 through 1200 screen pixels; null disables wrapping."
        }
      },
      "required": [
        "size_px",
        "family",
        "bold",
        "italic",
        "color"
      ],
      "type": "object"
    },
    "TextTarget": {
      "additionalProperties": false,
      "properties": {
        "drawing_id": {
          "$ref": "#/$defs/WireU64"
        },
        "pane_id": {
          "$ref": "#/$defs/WireU64"
        },
        "tab_id": {
          "$ref": "#/$defs/WireU64"
        }
      },
      "required": [
        "tab_id",
        "pane_id",
        "drawing_id"
      ],
      "type": "object"
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "changed": {
      "type": "boolean"
    },
    "properties": {
      "$ref": "#/$defs/TextProperties"
    },
    "target": {
      "$ref": "#/$defs/TextTarget"
    },
    "text_present": {
      "type": "boolean"
    }
  },
  "required": [
    "target",
    "properties",
    "text_present",
    "changed"
  ],
  "title": "TextResult",
  "type": "object"
}
