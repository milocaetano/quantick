{
  "$defs": {
    "Availability": {
      "properties": {
        "next_step": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/AvailabilityReasonId"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/AvailabilityStatus"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "AvailabilityReasonId": {
      "description": "A stable reason why a capability cannot run immediately.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,7}$",
      "type": "string"
    },
    "AvailabilityStatus": {
      "enum": [
        "available",
        "unavailable",
        "confirmation_required",
        "permission_denied"
      ],
      "type": "string"
    },
    "CapabilityDescriptor": {
      "properties": {
        "availability": {
          "$ref": "#/$defs/Availability"
        },
        "confirmation_class": {
          "$ref": "#/$defs/ConfirmationClassId"
        },
        "description": {
          "type": "string"
        },
        "destructive": {
          "type": "boolean"
        },
        "dry_run_supported": {
          "type": "boolean"
        },
        "effect": {
          "$ref": "#/$defs/EffectId"
        },
        "examples": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CapabilityExample"
          },
          "type": "array"
        },
        "expected_cost": {
          "$ref": "#/$defs/ExpectedCost"
        },
        "id": {
          "$ref": "#/$defs/CapabilityId"
        },
        "idempotency": {
          "$ref": "#/$defs/IdempotencyPolicy"
        },
        "input_schema": true,
        "module": {
          "$ref": "#/$defs/ModuleId"
        },
        "output_schema": true,
        "pagination": {
          "anyOf": [
            {
              "$ref": "#/$defs/PaginationConsistency"
            },
            {
              "type": "null"
            }
          ]
        },
        "persistence": {
          "$ref": "#/$defs/EffectPersistence"
        },
        "preconditions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PreconditionDescriptor"
          },
          "type": "array"
        },
        "read_only": {
          "type": "boolean"
        },
        "required_permissions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PermissionId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "reversible": {
          "type": "boolean"
        },
        "revision_policy": {
          "$ref": "#/$defs/RevisionPolicy"
        },
        "risk_flags": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RiskFlagId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "risk_reducing": {
          "type": "boolean"
        },
        "stale_input_safety": {
          "maxLength": 1024,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "version": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version",
        "title",
        "description",
        "module",
        "input_schema",
        "output_schema",
        "effect",
        "read_only",
        "idempotency",
        "revision_policy",
        "dry_run_supported",
        "persistence",
        "reversible",
        "destructive",
        "risk_reducing",
        "confirmation_class",
        "availability",
        "expected_cost"
      ],
      "type": "object"
    },
    "CapabilityExample": {
      "properties": {
        "input": true,
        "output": true,
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "input",
        "output"
      ],
      "type": "object"
    },
    "CapabilityId": {
      "description": "A versioned operation exposed by a module.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,7}$",
      "type": "string"
    },
    "ConfirmationClassId": {
      "description": "An application-defined confirmation policy class.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,7}$",
      "type": "string"
    },
    "CostClassId": {
      "description": "A declared cold-path execution cost class.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,7}$",
      "type": "string"
    },
    "DefaultGrant": {
      "enum": [
        "granted",
        "denied",
        "prompt"
      ],
      "type": "string"
    },
    "EffectId": {
      "description": "A remote effect classification.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,7}$",
      "type": "string"
    },
    "EffectPersistence": {
      "enum": [
        "none",
        "transient",
        "durable"
      ],
      "type": "string"
    },
    "ExpectedCost": {
      "properties": {
        "class": {
          "$ref": "#/$defs/CostClassId"
        },
        "max_items": {
          "format": "uint",
          "maximum": 2048,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_response_bytes": {
          "format": "uint",
          "maximum": 8388608,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "class"
      ],
      "type": "object"
    },
    "IdempotencyPolicy": {
      "enum": [
        "forbidden",
        "optional",
        "required"
      ],
      "type": "string"
    },
    "InstanceId": {
      "description": "The identity of one running Quantick instance.",
      "maxLength": 22,
      "minLength": 22,
      "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$",
      "type": "string"
    },
    "ModuleDescriptor": {
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ModuleId"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "description"
      ],
      "type": "object"
    },
    "ModuleId": {
      "description": "A module contributing control-plane behavior.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,7}$",
      "type": "string"
    },
    "PaginationConsistency": {
      "enum": [
        "revision_locked",
        "append_only",
        "retained_resource"
      ],
      "type": "string"
    },
    "PermissionDescriptor": {
      "properties": {
        "default_grant": {
          "$ref": "#/$defs/DefaultGrant"
        },
        "description": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/PermissionId"
        },
        "label": {
          "type": "string"
        },
        "profile_ceilings": {
          "items": {
            "$ref": "#/$defs/ProfileId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "sensitive": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "description",
        "sensitive",
        "default_grant",
        "profile_ceilings"
      ],
      "type": "object"
    },
    "PermissionId": {
      "description": "A granular authority or data-read grant.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,7}$",
      "type": "string"
    },
    "PreconditionDescriptor": {
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/PreconditionId"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "type": "object"
    },
    "PreconditionId": {
      "description": "A stable namespaced capability precondition.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,7}$",
      "type": "string"
    },
    "ProfileDescriptor": {
      "properties": {
        "id": {
          "$ref": "#/$defs/ProfileId"
        },
        "inherits": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProfileId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "label": {
          "type": "string"
        },
        "permissions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PermissionId"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "label"
      ],
      "type": "object"
    },
    "ProfileId": {
      "description": "An application-registered authority ceiling.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,7}$",
      "type": "string"
    },
    "ProtocolLimits": {
      "properties": {
        "default_page_items": {
          "format": "uint",
          "maximum": 2048,
          "minimum": 1,
          "type": "integer"
        },
        "max_frame_bytes": {
          "format": "uint",
          "maximum": 16777216,
          "minimum": 1,
          "type": "integer"
        },
        "max_json_depth": {
          "format": "uint",
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        },
        "max_page_items": {
          "format": "uint",
          "maximum": 2048,
          "minimum": 1,
          "type": "integer"
        },
        "max_request_bytes": {
          "format": "uint",
          "maximum": 1048576,
          "minimum": 1,
          "type": "integer"
        },
        "max_response_bytes": {
          "format": "uint",
          "maximum": 8388608,
          "minimum": 1,
          "type": "integer"
        },
        "max_string_bytes": {
          "format": "uint",
          "maximum": 262144,
          "minimum": 1,
          "type": "integer"
        },
        "request_timeout_ms": {
          "format": "uint64",
          "maximum": 5000,
          "minimum": 1,
          "type": "integer"
        },
        "wait_timeout_max_ms": {
          "format": "uint64",
          "maximum": 30000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "max_frame_bytes",
        "max_request_bytes",
        "max_response_bytes",
        "max_json_depth",
        "max_string_bytes",
        "default_page_items",
        "max_page_items",
        "request_timeout_ms",
        "wait_timeout_max_ms"
      ],
      "type": "object"
    },
    "RevisionPolicy": {
      "enum": [
        "forbidden",
        "optional_for_additive",
        "required"
      ],
      "type": "string"
    },
    "RiskFlagId": {
      "description": "A declared side effect or risk dimension.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,7}$",
      "type": "string"
    },
    "SnapshotScopeDescriptor": {
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/SnapshotScopeId"
        },
        "module_id": {
          "$ref": "#/$defs/ModuleId"
        },
        "required_permissions": {
          "items": {
            "$ref": "#/$defs/PermissionId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "schema": true,
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "module_id",
        "schema_version",
        "title",
        "description",
        "required_permissions",
        "schema"
      ],
      "type": "object"
    },
    "SnapshotScopeId": {
      "description": "A namespaced semantic snapshot projection.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,7}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "application_commit": {
      "type": "string"
    },
    "application_version": {
      "type": "string"
    },
    "capabilities": {
      "items": {
        "$ref": "#/$defs/CapabilityDescriptor"
      },
      "type": "array"
    },
    "effective_limits": {
      "$ref": "#/$defs/ProtocolLimits"
    },
    "effective_profile": {
      "$ref": "#/$defs/ProfileId"
    },
    "effective_scopes": {
      "items": {
        "$ref": "#/$defs/PermissionId"
      },
      "type": "array",
      "uniqueItems": true
    },
    "instance_id": {
      "$ref": "#/$defs/InstanceId"
    },
    "modules": {
      "items": {
        "$ref": "#/$defs/ModuleDescriptor"
      },
      "type": "array"
    },
    "permissions": {
      "items": {
        "$ref": "#/$defs/PermissionDescriptor"
      },
      "type": "array"
    },
    "profiles": {
      "items": {
        "$ref": "#/$defs/ProfileDescriptor"
      },
      "type": "array"
    },
    "protocol_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "snapshot_scopes": {
      "items": {
        "$ref": "#/$defs/SnapshotScopeDescriptor"
      },
      "type": "array"
    }
  },
  "required": [
    "instance_id",
    "application_version",
    "application_commit",
    "protocol_version",
    "effective_profile",
    "effective_scopes",
    "effective_limits",
    "modules",
    "profiles",
    "permissions",
    "capabilities",
    "snapshot_scopes"
  ],
  "title": "DescribeResult",
  "type": "object"
}
