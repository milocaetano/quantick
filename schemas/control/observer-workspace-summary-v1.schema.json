{
  "$defs": {
    "CanonicalDecimal": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
      "type": "string"
    },
    "CanvasLayoutDto": {
      "enum": [
        "flow",
        "time",
        "time_and_flow",
        "time_time_and_flow"
      ],
      "type": "string"
    },
    "LayoutTabSnapshot": {
      "description": "One layout tab, as the strip lists it.",
      "properties": {
        "active": {
          "type": "boolean"
        },
        "indicator_count": {
          "$ref": "#/$defs/WireU64",
          "description": "How many indicators the layout holds."
        },
        "layout_id": {
          "$ref": "#/$defs/WireU64"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "layout_id",
        "name",
        "active",
        "indicator_count"
      ],
      "type": "object"
    },
    "PaneSideDto": {
      "enum": [
        "flow",
        "time"
      ],
      "type": "string"
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "WorkspacePane": {
      "properties": {
        "focused": {
          "type": "boolean"
        },
        "pane_id": {
          "$ref": "#/$defs/WireU64"
        },
        "pane_index": {
          "$ref": "#/$defs/WireU64",
          "description": "The pane's address within its tab — the number `layout.focus` takes."
        },
        "side": {
          "$ref": "#/$defs/PaneSideDto"
        },
        "visible": {
          "type": "boolean"
        }
      },
      "required": [
        "pane_id",
        "side",
        "pane_index",
        "visible",
        "focused"
      ],
      "type": "object"
    },
    "WorkspaceTab": {
      "properties": {
        "active": {
          "type": "boolean"
        },
        "feed_id": {
          "type": "string"
        },
        "focused_pane": {
          "$ref": "#/$defs/PaneSideDto"
        },
        "index": {
          "$ref": "#/$defs/WireU64"
        },
        "label": {
          "type": "string"
        },
        "layout": {
          "$ref": "#/$defs/CanvasLayoutDto"
        },
        "panes": {
          "items": {
            "$ref": "#/$defs/WorkspacePane"
          },
          "type": "array"
        },
        "split_fraction": {
          "$ref": "#/$defs/CanonicalDecimal"
        },
        "symbol": {
          "type": "string"
        },
        "tab_id": {
          "$ref": "#/$defs/WireU64"
        }
      },
      "required": [
        "index",
        "tab_id",
        "label",
        "feed_id",
        "symbol",
        "active",
        "layout",
        "focused_pane",
        "split_fraction",
        "panes"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "active_tab_id": {
      "$ref": "#/$defs/WireU64"
    },
    "active_tab_index": {
      "$ref": "#/$defs/WireU64"
    },
    "history_reach": {
      "description": "How far one press of *load older* reaches, as the reach registry's own\ntoken (`page`, `previous-session`) — the same string the harness hook\ntakes, so what an operator sets is what it reads back.",
      "type": "string"
    },
    "layouts": {
      "default": [],
      "description": "The layout strip: every layout, and which is active. Additive.",
      "items": {
        "$ref": "#/$defs/LayoutTabSnapshot"
      },
      "type": "array"
    },
    "performance_readings_visible": {
      "type": "boolean"
    },
    "progressive_venue_history": {
      "type": "boolean"
    },
    "save_on_exit": {
      "type": "boolean"
    },
    "tabs": {
      "items": {
        "$ref": "#/$defs/WorkspaceTab"
      },
      "type": "array"
    },
    "timezone_label": {
      "type": "string"
    },
    "timezone_offset_minutes": {
      "format": "int32",
      "type": "integer"
    },
    "venue_lead_in": {
      "description": "Whether a chart cut by trades carries the venue's candles in front of\nits bars. Read with each pane's `venue_prefix_present`: this is what\nthe trader asked for, that is what the pane actually holds.",
      "type": "boolean"
    }
  },
  "required": [
    "active_tab_index",
    "active_tab_id",
    "timezone_offset_minutes",
    "timezone_label",
    "save_on_exit",
    "performance_readings_visible",
    "progressive_venue_history",
    "history_reach",
    "venue_lead_in",
    "tabs"
  ],
  "title": "WorkspaceSnapshot",
  "type": "object"
}
