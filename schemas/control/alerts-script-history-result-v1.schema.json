{
  "$defs": {
    "AlarmSource": {
      "description": "The wire shape of [`SourceContext`], as `alerts.*` market sources are.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "Live": {
              "properties": {
                "feed": {
                  "type": "string"
                }
              },
              "required": [
                "feed"
              ],
              "type": "object"
            }
          },
          "required": [
            "Live"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Replay": {
              "properties": {
                "recording": {
                  "type": "string"
                }
              },
              "required": [
                "recording"
              ],
              "type": "object"
            }
          },
          "required": [
            "Replay"
          ],
          "type": "object"
        }
      ]
    },
    "ScriptAlarm": {
      "properties": {
        "bar_close_ms": {
          "description": "Close time of the bar that raised it, exchange milliseconds.",
          "format": "int64",
          "type": "integer"
        },
        "indicator": {
          "description": "The indicator's title, as its legend shows it.",
          "type": "string"
        },
        "message": {
          "description": "The `alertcondition` message; the title when the script gave none.",
          "type": "string"
        },
        "sequence": {
          "$ref": "#/$defs/WireU64",
          "description": "Increasing from 1 for the session; never reused."
        },
        "source": {
          "$ref": "#/$defs/AlarmSource",
          "description": "Where the bar closed: the live feed, or the recording a replay plays."
        },
        "symbol": {
          "description": "The market of the tab whose chart raised it, read when it arrived.",
          "type": "string"
        },
        "title": {
          "description": "The `alertcondition` title.",
          "type": "string"
        },
        "utc_ms": {
          "description": "When the window delivered it, UTC milliseconds.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "utc_ms",
        "source",
        "symbol",
        "indicator",
        "title",
        "message",
        "bar_close_ms"
      ],
      "type": "object"
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "alarms": {
      "description": "Oldest first; the session keeps the newest 256.",
      "items": {
        "$ref": "#/$defs/ScriptAlarm"
      },
      "type": "array"
    },
    "last_sequence": {
      "$ref": "#/$defs/WireU64",
      "description": "The newest sequence ever raised (0: none yet). Pass it as `after` to\nread only what comes next."
    },
    "oldest_sequence": {
      "$ref": "#/$defs/WireU64",
      "description": "The oldest sequence still kept (0: none kept). An `after` below this\nminus one means the alarms between were dropped unread."
    }
  },
  "required": [
    "alarms",
    "last_sequence",
    "oldest_sequence"
  ],
  "title": "History",
  "type": "object"
}
