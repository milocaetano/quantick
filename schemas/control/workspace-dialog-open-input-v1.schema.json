{
  "$defs": {
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "WorkspaceDialog": {
      "description": "Which dialog to open.",
      "oneOf": [
        {
          "const": "save_as",
          "description": "Save as new workspace: the tab's copy under a new name.",
          "type": "string"
        },
        {
          "const": "new",
          "description": "New workspace: an empty recipe.",
          "type": "string"
        },
        {
          "const": "manage",
          "description": "Manage workspaces.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Open a workspace dialog on a tab.",
  "properties": {
    "charts": {
      "description": "New dialog only: initial draft chart count (1-8).",
      "format": "uint",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "custom_hex": {
      "description": "New dialog only: draft HEX, including incomplete text for inline feedback.",
      "type": [
        "string",
        "null"
      ]
    },
    "mode": {
      "$ref": "#/$defs/WorkspaceDialog"
    },
    "tab_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/WireU64"
        },
        {
          "type": "null"
        }
      ],
      "description": "The tab. Left out, the one on screen."
    },
    "timeframe_ms": {
      "anyOf": [
        {
          "$ref": "#/$defs/WireU64"
        },
        {
          "type": "null"
        }
      ],
      "description": "New dialog only: initial draft interval, without creating anything."
    }
  },
  "required": [
    "mode"
  ],
  "title": "WorkspaceDialogOpenInput",
  "type": "object"
}
