{
  "$defs": {
    "CanonicalDecimal": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
      "type": "string"
    },
    "JournalSourceFilter": {
      "description": "The ledger's source pills.",
      "oneOf": [
        {
          "const": "broker",
          "description": "Trades sent to a broker, including DEMO and REAL accounts.",
          "type": "string"
        },
        {
          "const": "simulator",
          "description": "All simulator trades, on live and replay feeds.",
          "type": "string"
        },
        {
          "const": "real",
          "description": "Live sessions, and files from before a source was recorded.",
          "type": "string"
        },
        {
          "const": "replay",
          "description": "Replay-driven practice sessions.",
          "type": "string"
        },
        {
          "const": "both",
          "description": "Everything.",
          "type": "string"
        }
      ]
    },
    "MergedWire": {
      "description": "What a merge converted, with which rates, and what it left out.",
      "properties": {
        "assets": {
          "description": "The merged symbols, each with its own currency.",
          "items": {
            "items": {
              "type": "string"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        },
        "caption": {
          "description": "The caption under the merged curve.",
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "net": {
          "$ref": "#/$defs/CanonicalDecimal",
          "description": "The merged net in `currency`."
        },
        "rate_count": {
          "$ref": "#/$defs/WireU64"
        },
        "rates": {
          "description": "The rates used per day, oldest first; past 16, only the newest 16.",
          "items": {
            "$ref": "#/$defs/RateUsedWire"
          },
          "type": "array"
        },
        "unconverted": {
          "description": "What was not converted, never guessed; past 16, only the first 16.",
          "items": {
            "$ref": "#/$defs/UnconvertedWire"
          },
          "type": "array"
        },
        "unconverted_count": {
          "$ref": "#/$defs/WireU64"
        }
      },
      "required": [
        "currency",
        "assets",
        "rates",
        "rate_count",
        "unconverted",
        "unconverted_count",
        "net",
        "caption"
      ],
      "type": "object"
    },
    "RateUsedWire": {
      "description": "One rate a merged report converted with.",
      "properties": {
        "day": {
          "description": "YYYY-MM-DD, the civil day of the closes it converted.",
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "rate": {
          "$ref": "#/$defs/CanonicalDecimal"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "day",
        "from",
        "to",
        "rate"
      ],
      "type": "object"
    },
    "ReportResult": {
      "properties": {
        "action": {
          "type": "string"
        },
        "day": {
          "type": [
            "string",
            "null"
          ]
        },
        "net_points": {
          "$ref": "#/$defs/CanonicalDecimal"
        },
        "origin": {
          "type": "string"
        },
        "session": {
          "description": "The session of a session or day action; null for whole_day and tag.",
          "type": [
            "string",
            "null"
          ]
        },
        "skipped_rows": {
          "$ref": "#/$defs/WireU64",
          "description": "Malformed rows skipped in that history."
        },
        "tag": {
          "description": "The normalized tag of a tag action, without `#`.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "trade_count": {
          "$ref": "#/$defs/WireU64"
        },
        "unreadable_files": {
          "$ref": "#/$defs/WireU64",
          "description": "Files unreadable in the history scanned for this report."
        }
      },
      "required": [
        "action",
        "origin",
        "title",
        "trade_count",
        "unreadable_files",
        "skipped_rows",
        "net_points"
      ],
      "type": "object"
    },
    "UnconvertedWire": {
      "description": "Trades of one symbol on one day a merge left out.",
      "properties": {
        "day": {
          "type": "string"
        },
        "from": {
          "description": "The currency without a rate, for `no_rate`.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "`point_value_unset` or `no_rate`.",
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "trades": {
          "$ref": "#/$defs/WireU64"
        }
      },
      "required": [
        "symbol",
        "day",
        "reason",
        "trades"
      ],
      "type": "object"
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/ReportResult"
    },
    {
      "properties": {
        "action": {
          "type": "string"
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "title"
      ],
      "type": "object"
    },
    {
      "properties": {
        "action": {
          "type": "string"
        },
        "applied_day_count": {
          "$ref": "#/$defs/WireU64",
          "description": "How many days are picked, including any past the listed 92."
        },
        "applied_days": {
          "description": "The picked days in force, oldest first; past 92, only the\nnewest 92. Empty while the period is in force.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "currencies": {
          "description": "The currencies a merge can read in.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "loaded": {
          "type": "boolean"
        },
        "merge": {
          "description": "The merge in force; null reads per asset.",
          "type": [
            "string",
            "null"
          ]
        },
        "merge_note": {
          "description": "Why a merge asked of a points report kept one curve per instrument.",
          "type": [
            "string",
            "null"
          ]
        },
        "merged": {
          "anyOf": [
            {
              "$ref": "#/$defs/MergedWire"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the merge converted; null per asset or in points."
        },
        "net_points": {
          "$ref": "#/$defs/CanonicalDecimal"
        },
        "open": {
          "type": "boolean"
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "skipped_rows": {
          "$ref": "#/$defs/WireU64"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/JournalSourceFilter"
          },
          "type": "array"
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "symbols": {
          "description": "The symbols chosen; empty reads every symbol.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "timezone": {
          "type": "string"
        },
        "trade_count": {
          "$ref": "#/$defs/WireU64"
        },
        "unreadable_files": {
          "$ref": "#/$defs/WireU64"
        },
        "window": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "sources",
        "open",
        "loaded",
        "window",
        "applied_days",
        "applied_day_count",
        "timezone",
        "symbols",
        "currencies",
        "trade_count",
        "unreadable_files",
        "skipped_rows",
        "net_points"
      ],
      "type": "object"
    }
  ],
  "title": "ReportOutput"
}
