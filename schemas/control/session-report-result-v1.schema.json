{
  "$defs": {
    "CanonicalDecimal": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
      "type": "string"
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "action": {
      "type": "string"
    },
    "day": {
      "type": [
        "string",
        "null"
      ]
    },
    "net_points": {
      "$ref": "#/$defs/CanonicalDecimal"
    },
    "origin": {
      "type": "string"
    },
    "session": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "trade_count": {
      "$ref": "#/$defs/WireU64"
    }
  },
  "required": [
    "action",
    "session",
    "origin",
    "title",
    "trade_count",
    "net_points"
  ],
  "title": "ReportResult",
  "type": "object"
}
