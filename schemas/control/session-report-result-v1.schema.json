{
  "$defs": {
    "CanonicalDecimal": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
      "type": "string"
    },
    "JournalSourceFilter": {
      "description": "The ledger's source pills.",
      "oneOf": [
        {
          "const": "broker",
          "description": "Trades sent to a broker, including DEMO and REAL accounts.",
          "type": "string"
        },
        {
          "const": "simulator",
          "description": "All simulator trades, on live and replay feeds.",
          "type": "string"
        },
        {
          "const": "real",
          "description": "Live sessions, and files from before a source was recorded.",
          "type": "string"
        },
        {
          "const": "replay",
          "description": "Replay-driven practice sessions.",
          "type": "string"
        },
        {
          "const": "both",
          "description": "Everything.",
          "type": "string"
        }
      ]
    },
    "ReportResult": {
      "properties": {
        "action": {
          "type": "string"
        },
        "day": {
          "type": [
            "string",
            "null"
          ]
        },
        "net_points": {
          "$ref": "#/$defs/CanonicalDecimal"
        },
        "origin": {
          "type": "string"
        },
        "session": {
          "description": "The session of a session or day action; null for whole_day and tag.",
          "type": [
            "string",
            "null"
          ]
        },
        "skipped_rows": {
          "$ref": "#/$defs/WireU64",
          "description": "Malformed rows skipped in that history."
        },
        "tag": {
          "description": "The normalized tag of a tag action, without `#`.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "trade_count": {
          "$ref": "#/$defs/WireU64"
        },
        "unreadable_files": {
          "$ref": "#/$defs/WireU64",
          "description": "Files unreadable in the history scanned for this report."
        }
      },
      "required": [
        "action",
        "origin",
        "title",
        "trade_count",
        "unreadable_files",
        "skipped_rows",
        "net_points"
      ],
      "type": "object"
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/ReportResult"
    },
    {
      "properties": {
        "action": {
          "type": "string"
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "title"
      ],
      "type": "object"
    },
    {
      "properties": {
        "action": {
          "type": "string"
        },
        "applied_end": {
          "type": [
            "string",
            "null"
          ]
        },
        "applied_start": {
          "type": [
            "string",
            "null"
          ]
        },
        "draft_end": {
          "type": "string"
        },
        "draft_start": {
          "type": "string"
        },
        "loaded": {
          "type": "boolean"
        },
        "net_points": {
          "$ref": "#/$defs/CanonicalDecimal"
        },
        "open": {
          "type": "boolean"
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "skipped_rows": {
          "$ref": "#/$defs/WireU64"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/JournalSourceFilter"
          },
          "type": "array"
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "timezone": {
          "type": "string"
        },
        "trade_count": {
          "$ref": "#/$defs/WireU64"
        },
        "unreadable_files": {
          "$ref": "#/$defs/WireU64"
        },
        "validation_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "window": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "sources",
        "open",
        "loaded",
        "window",
        "draft_start",
        "draft_end",
        "timezone",
        "trade_count",
        "unreadable_files",
        "skipped_rows",
        "net_points"
      ],
      "type": "object"
    }
  ],
  "title": "ReportOutput"
}
