{
  "$defs": {
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "WorkspaceColourDto": {
      "description": "A workspace's colour: one slot of a fixed palette of eight, never held by\ntwo workspaces (`workspace.colour.set`).",
      "enum": [
        "steel",
        "violet",
        "cyan",
        "magenta",
        "azure",
        "indigo",
        "chalk",
        "cobalt"
      ],
      "type": "string"
    },
    "WorkspaceEntry": {
      "description": "One workspace and the tabs using it.",
      "properties": {
        "colour": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkspaceColourDto"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Its colour; `None` for a ninth while all eight are held. Additive."
        },
        "name": {
          "type": "string"
        },
        "summary": {
          "description": "One line: the panes, each context pane's interval and the indicator\ncount, e.g. `Time 1m · Flow · 3 ind`.",
          "type": "string"
        },
        "tabs": {
          "items": {
            "$ref": "#/$defs/WireU64"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "summary",
        "tabs"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Every workspace, `Default` first, then by name.",
  "properties": {
    "workspaces": {
      "items": {
        "$ref": "#/$defs/WorkspaceEntry"
      },
      "type": "array"
    }
  },
  "required": [
    "workspaces"
  ],
  "title": "WorkspaceListResult",
  "type": "object"
}
