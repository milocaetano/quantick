{
  "$defs": {
    "ChartSettingsTab": {
      "description": "A tab of the chart settings window.",
      "oneOf": [
        {
          "const": "candles",
          "description": "Candle and canvas appearance, with its presets.",
          "type": "string"
        },
        {
          "const": "footprint",
          "description": "The focused chart's footprint knobs, with their presets.",
          "type": "string"
        }
      ]
    },
    "ChartSettingsTarget": {
      "additionalProperties": false,
      "description": "Stable runtime address, published by chart.summary. Both IDs must still exist.",
      "properties": {
        "pane_id": {
          "$ref": "#/$defs/WireU64"
        },
        "tab_id": {
          "$ref": "#/$defs/WireU64"
        }
      },
      "required": [
        "tab_id",
        "pane_id"
      ],
      "type": "object"
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The window and the candle presets after the call.",
  "properties": {
    "built_in_presets": {
      "description": "The built-in presets, by label, in the window's order.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "candle_preset": {
      "description": "The preset the chart's look answers to: a built-in label when the\ncandles match one, a saved name when the whole look matches one, or\n`None` for a look nobody named.",
      "type": [
        "string",
        "null"
      ]
    },
    "changed": {
      "description": "Whether the call changed the window, the appearance or the saved list.",
      "type": "boolean"
    },
    "custom_presets": {
      "description": "The saved looks, alphabetically.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "effective_style": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "One pane's candle/canvas style: read effective_style, edit values and ownership, submit it whole to update_candles. Geometry and opacity are canonical decimal strings in inclusive bounds.",
          "properties": {
            "candles": {
              "additionalProperties": false,
              "properties": {
                "bear_fill": {
                  "description": "sRGB red, green and blue byte values, in that order.",
                  "items": {
                    "maximum": 255,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": "array"
                },
                "bear_outline": {
                  "description": "sRGB red, green and blue byte values, in that order.",
                  "items": {
                    "maximum": 255,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": "array"
                },
                "body_width_frac": {
                  "description": "Decimal [0.1, 1], inclusive.",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                  "type": "string"
                },
                "bull_fill": {
                  "description": "sRGB red, green and blue byte values, in that order.",
                  "items": {
                    "maximum": 255,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": "array"
                },
                "bull_outline": {
                  "description": "sRGB red, green and blue byte values, in that order.",
                  "items": {
                    "maximum": 255,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": "array"
                },
                "corner_radius": {
                  "description": "Decimal [0, 8], inclusive.",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                  "type": "string"
                },
                "custom_wick_color": {
                  "type": "boolean"
                },
                "fill_opacity": {
                  "description": "Decimal [0, 1], inclusive.",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                  "type": "string"
                },
                "forming_opacity": {
                  "description": "Decimal [0, 1], inclusive.",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                  "type": "string"
                },
                "gap_px": {
                  "description": "Decimal [0, 8], inclusive.",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                  "type": "string"
                },
                "min_body_height": {
                  "description": "Decimal [1, 12], inclusive.",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                  "type": "string"
                },
                "outline_only": {
                  "type": "boolean"
                },
                "outline_opacity": {
                  "description": "Decimal [0, 1], inclusive.",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                  "type": "string"
                },
                "outline_width": {
                  "description": "Decimal [0.5, 4], inclusive.",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                  "type": "string"
                },
                "show_wicks": {
                  "type": "boolean"
                },
                "wick": {
                  "description": "sRGB red, green and blue byte values, in that order.",
                  "items": {
                    "maximum": 255,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": "array"
                },
                "wick_opacity": {
                  "description": "Decimal [0, 1], inclusive.",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                  "type": "string"
                },
                "wick_width": {
                  "description": "Decimal [0.5, 4], inclusive.",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                  "type": "string"
                }
              },
              "required": [
                "outline_only",
                "bull_fill",
                "bear_fill",
                "bull_outline",
                "bear_outline",
                "fill_opacity",
                "outline_opacity",
                "outline_width",
                "show_wicks",
                "custom_wick_color",
                "wick",
                "wick_opacity",
                "wick_width",
                "body_width_frac",
                "gap_px",
                "corner_radius",
                "min_body_height",
                "forming_opacity"
              ],
              "type": "object"
            },
            "canvas": {
              "additionalProperties": false,
              "properties": {
                "background": {
                  "description": "sRGB red, green and blue byte values, in that order.",
                  "items": {
                    "maximum": 255,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": "array"
                },
                "background_enabled": {
                  "type": "boolean"
                },
                "grid": {
                  "description": "sRGB red, green and blue byte values, in that order.",
                  "items": {
                    "maximum": 255,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": "array"
                },
                "grid_enabled": {
                  "type": "boolean"
                },
                "grid_opacity": {
                  "description": "Decimal [0, 1], inclusive.",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                  "type": "string"
                },
                "time_grid_enabled": {
                  "type": "boolean"
                }
              },
              "required": [
                "background_enabled",
                "background",
                "grid_enabled",
                "grid",
                "grid_opacity"
              ],
              "type": "object"
            },
            "ownership": {
              "additionalProperties": false,
              "description": "Theme follows the chart's theme; explicit keeps the value across themes. Omitted markers are explicit; inspect returns all.",
              "properties": {
                "background": {
                  "enum": [
                    "theme",
                    "explicit"
                  ],
                  "type": "string"
                },
                "bear_fill": {
                  "enum": [
                    "theme",
                    "explicit"
                  ],
                  "type": "string"
                },
                "bear_outline": {
                  "enum": [
                    "theme",
                    "explicit"
                  ],
                  "type": "string"
                },
                "bull_fill": {
                  "enum": [
                    "theme",
                    "explicit"
                  ],
                  "type": "string"
                },
                "bull_outline": {
                  "enum": [
                    "theme",
                    "explicit"
                  ],
                  "type": "string"
                },
                "fill_opacity": {
                  "enum": [
                    "theme",
                    "explicit"
                  ],
                  "type": "string"
                },
                "grid": {
                  "enum": [
                    "theme",
                    "explicit"
                  ],
                  "type": "string"
                },
                "outline_opacity": {
                  "enum": [
                    "theme",
                    "explicit"
                  ],
                  "type": "string"
                },
                "outline_width": {
                  "enum": [
                    "theme",
                    "explicit"
                  ],
                  "type": "string"
                },
                "time_grid": {
                  "enum": [
                    "theme",
                    "explicit"
                  ],
                  "type": "string"
                },
                "wick": {
                  "enum": [
                    "theme",
                    "explicit"
                  ],
                  "type": "string"
                },
                "wick_opacity": {
                  "enum": [
                    "theme",
                    "explicit"
                  ],
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          "required": [
            "candles",
            "canvas"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "description": "Effective candle/canvas values and explicit/theme ownership. This is\nthe complete style document accepted by update_candles."
    },
    "open": {
      "description": "Whether the window is on screen.",
      "type": "boolean"
    },
    "tab": {
      "$ref": "#/$defs/ChartSettingsTab",
      "description": "The tab it shows, or would show when opened."
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChartSettingsTarget"
        },
        {
          "type": "null"
        }
      ],
      "description": "Address whose appearance this result describes."
    }
  },
  "required": [
    "open",
    "effective_style",
    "tab",
    "built_in_presets",
    "custom_presets",
    "changed"
  ],
  "title": "ChartSettingsResult",
  "type": "object"
}
