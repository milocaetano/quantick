{
  "$defs": {
    "CanvasPaneDto": {
      "description": "One pane of the canvas after the call.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/CanvasPaneKind"
        },
        "mode": {
          "$ref": "#/$defs/CanvasPaneMode"
        },
        "slot": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "slot",
        "kind",
        "mode"
      ],
      "type": "object"
    },
    "CanvasPaneKind": {
      "description": "What a pane is for.",
      "enum": [
        "time",
        "flow"
      ],
      "type": "string"
    },
    "CanvasPaneMode": {
      "description": "How a pane is shown.",
      "enum": [
        "docked",
        "minimized",
        "maximized",
        "floating",
        "os_window"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The canvas as it stands after a canvas call.",
  "properties": {
    "changed": {
      "description": "Whether the call changed the canvas; a repeat answers false.",
      "type": "boolean"
    },
    "panes": {
      "description": "Every pane, in slot order.",
      "items": {
        "$ref": "#/$defs/CanvasPaneDto"
      },
      "type": "array"
    },
    "preset_id": {
      "description": "The preset the docked panes match; absent for a custom arrangement.",
      "type": [
        "string",
        "null"
      ]
    },
    "slot": {
      "description": "The pane the call acted on, or the one it added.",
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "unsaved": {
      "description": "Whether the workspace now differs from its save.",
      "type": "boolean"
    }
  },
  "required": [
    "changed",
    "unsaved",
    "panes"
  ],
  "title": "CanvasResult",
  "type": "object"
}
