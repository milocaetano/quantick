{
  "$defs": {
    "AvailabilitySnapshot": {
      "properties": {
        "available": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "available"
      ],
      "type": "object"
    },
    "CanonicalDecimal": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
      "type": "string"
    },
    "ReplaySessionSnapshot": {
      "properties": {
        "date": {
          "description": "Session day as `YYYY-MM-DD`, when the file name followed the\nconvention. Absent is honest: the recording did not say.",
          "type": [
            "string",
            "null"
          ]
        },
        "elapsed_ms": {
          "description": "Wall time spent playing, which a seek resets — not the distance\ntravelled through the recording, which is `position_unix_ms`.",
          "format": "int64",
          "type": "integer",
          "x-unit": "milliseconds"
        },
        "end_unix_ms": {
          "format": "int64",
          "type": "integer",
          "x-unit": "unix_milliseconds"
        },
        "file_name": {
          "description": "The recording's file name only. The absolute path is deliberately not\npublished: it identifies nothing a client needs and would leak the\ntrader's directory layout to every observer.",
          "type": "string"
        },
        "finished": {
          "type": "boolean"
        },
        "played_trades": {
          "$ref": "#/$defs/WireU64"
        },
        "playing": {
          "type": "boolean"
        },
        "position_unix_ms": {
          "format": "int64",
          "type": "integer",
          "x-unit": "unix_milliseconds"
        },
        "progress": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalDecimal"
            },
            {
              "type": "null"
            }
          ],
          "x-unit": "ratio"
        },
        "rewinds": {
          "$ref": "#/$defs/WireU64"
        },
        "speed": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalDecimal"
            },
            {
              "type": "null"
            }
          ],
          "x-unit": "playback_multiple"
        },
        "start_unix_ms": {
          "format": "int64",
          "type": "integer",
          "x-unit": "unix_milliseconds"
        },
        "symbol": {
          "type": "string"
        },
        "total_trades": {
          "$ref": "#/$defs/WireU64"
        },
        "trace": {
          "$ref": "#/$defs/ReplayTraceSnapshot"
        }
      },
      "required": [
        "symbol",
        "file_name",
        "playing",
        "finished",
        "position_unix_ms",
        "start_unix_ms",
        "end_unix_ms",
        "elapsed_ms",
        "played_trades",
        "total_trades",
        "rewinds",
        "trace"
      ],
      "type": "object"
    },
    "ReplayTraceSnapshot": {
      "description": "What the capture can honestly say about the control trace beside the\nrecording (contract §11).",
      "properties": {
        "complete": {
          "$ref": "#/$defs/AvailabilitySnapshot",
          "description": "Whether every recorded intent carries a terminal result — the property\nthat decides if the run is a deterministic fixture.\n\nDeliberately not answered here. Deciding it means reading and parsing\nthe whole sidecar, whose size is unbounded, and a capture runs on the\nUI thread under `CONTROL_UI_BUDGET_US`. A client that needs the verdict\nasks the gateway, which loads each recording's trace once."
        },
        "present": {
          "description": "A sidecar exists next to the recording. One metadata lookup, which is\nbounded work; the file is not opened.",
          "type": "boolean"
        }
      },
      "required": [
        "present",
        "complete"
      ],
      "type": "object"
    },
    "TabReplaySnapshot": {
      "properties": {
        "replaying": {
          "description": "A tab playing no recording is live; `session` is then absent rather\nthan a zeroed row, so \"not replaying\" cannot be mistaken for \"at the\nstart of a recording\".",
          "type": "boolean"
        },
        "session": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReplaySessionSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "tab_id": {
          "$ref": "#/$defs/WireU64"
        }
      },
      "required": [
        "tab_id",
        "replaying"
      ],
      "type": "object"
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "tabs": {
      "items": {
        "$ref": "#/$defs/TabReplaySnapshot"
      },
      "type": "array"
    }
  },
  "required": [
    "tabs"
  ],
  "title": "ReplaySnapshot",
  "type": "object"
}
