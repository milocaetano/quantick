{
  "$defs": {
    "DragSnapshot": {
      "properties": {
        "cancelled": {
          "description": "True after cancellation until another drag begins or completes.",
          "type": "boolean"
        },
        "pending": {
          "type": "boolean"
        },
        "source_window_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/WireU64"
            },
            {
              "type": "null"
            }
          ]
        },
        "tab_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/WireU64"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "pending",
        "cancelled"
      ],
      "type": "object"
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "changed": {
      "type": "boolean"
    },
    "drag": {
      "$ref": "#/$defs/DragSnapshot"
    },
    "position": {
      "anyOf": [
        {
          "$ref": "#/$defs/WireU64"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_window_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/WireU64"
        },
        {
          "type": "null"
        }
      ]
    },
    "tab_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/WireU64"
        },
        {
          "type": "null"
        }
      ]
    },
    "window_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/WireU64"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "changed",
    "drag"
  ],
  "title": "TabOperationResult",
  "type": "object"
}
