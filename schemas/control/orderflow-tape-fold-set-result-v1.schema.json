{
  "$defs": {
    "TapeFold": {
      "description": "Which side of the pane is closed to a rail.",
      "oneOf": [
        {
          "const": "open",
          "description": "Candles and tape side by side: the view `beside`.",
          "type": "string"
        },
        {
          "const": "candles",
          "description": "The candles closed to a rail on the left: the view `tape`, tape only.",
          "type": "string"
        },
        {
          "const": "tape",
          "description": "The tape closed to a rail on the right: the view `candles`, the tape off.",
          "type": "string"
        }
      ]
    },
    "WireU64": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "changed": {
      "type": "boolean"
    },
    "fold": {
      "$ref": "#/$defs/TapeFold"
    },
    "pane_id": {
      "$ref": "#/$defs/WireU64"
    },
    "tab_id": {
      "$ref": "#/$defs/WireU64"
    }
  },
  "required": [
    "tab_id",
    "pane_id",
    "fold",
    "changed"
  ],
  "title": "TapeFoldResult",
  "type": "object"
}
